[
    {
        "TextId": 1,
        "ActorName": "库助助",
        "ActorTalk": "您好，请问有什么需要帮助吗？"
    },
    {
        "TextId": 2,
        "ActorName": "库助助",
        "ActorTalk": "时序广场的视觉焦点，无疑是中心那棵名为“星幕树”的投影，其引人入胜的光影设计，构成了此地独特的视觉符号。"
    },
    {
        "TextId": 3,
        "ActorName": "库助助",
        "ActorTalk": "许多人喜欢在这里稍作停留，欣赏光影变幻，享受片刻的放松。"
    },
    {
        "TextId": 4,
        "ActorName": "库助助",
        "ActorTalk": "由于广场连接着生活区与商业区，这里自然成为了人流交汇往来的热门通道。"
    },
    {
        "TextId": 5,
        "ActorName": "库助助",
        "ActorTalk": "而它开阔疏朗的空间设计，也为川流不息的人们提供了舒适、便捷的通行体验。"
    },
    {
        "TextId": 6,
        "ActorTalk": "请给我介绍下“时序广场”。"
    },
    {
        "TextId": 7,
        "ActorTalk": "没什么事。"
    }
]