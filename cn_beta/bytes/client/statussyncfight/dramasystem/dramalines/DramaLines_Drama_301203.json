[
    {
        "TextId": 1,
        "ActorName": "里",
        "ActorTalk": "从梦晖绿荫这边人造光源的强度来看……",
        "Cv": 510024013
    },
    {
        "TextId": 2,
        "ActorName": "里",
        "ActorTalk": "空中花园今天应该也是好天气。",
        "Cv": 510024014
    },
    {
        "TextId": 3,
        "ActorName": "[PlayerName]",
        "ActorTalk": "宇宙却黑暗寂静——里是这么想的吧？"
    },
    {
        "TextId": 4,
        "ActorName": "里",
        "ActorTalk": "你可以自由地推测，我保留沉默的权利。",
        "Cv": 510024015
    },
    {
        "TextId": 5,
        "ActorName": "[PlayerName]",
        "ActorTalk": "可是那次在安检廊桥，你说过差不多一样的话。"
    },
    {
        "TextId": 6,
        "ActorName": "里",
        "ActorTalk": "这个表述恐怕并不准确。",
        "Cv": 510024016
    },
    {
        "TextId": 7,
        "ActorName": "里",
        "ActorTalk": "至少，心情完全不一样了。",
        "Cv": 510024017
    },
    {
        "TextId": 8,
        "ActorName": "[PlayerName]",
        "ActorTalk": "嗯？你说什么？"
    },
    {
        "TextId": 9,
        "ActorName": "里",
        "ActorTalk": "没什么。",
        "Cv": 510024018
    },
    {
        "TextId": 10,
        "ActorName": "[PlayerName]",
        "ActorTalk": "怎么又这样。里，重要的话要用正常音量。"
    },
    {
        "TextId": 11,
        "ActorName": "[PlayerName]",
        "ActorTalk": "……猫咪的叫声都比你的声音大。"
    }
]