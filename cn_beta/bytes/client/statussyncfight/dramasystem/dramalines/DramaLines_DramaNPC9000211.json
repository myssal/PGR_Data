[
    {
        "TextId": 1,
        "ActorName": "翠丝",
        "ActorTalk": "您好，有什么可以帮助您的吗？"
    },
    {
        "TextId": 2,
        "ActorName": "[PlayerName]",
        "ActorTalk": "你好像……不是内勤人员吧。"
    },
    {
        "TextId": 3,
        "ActorName": "翠丝",
        "ActorTalk": "我正因为斗殴而被处罚中。区区三天的公共服务而已……"
    },
    {
        "TextId": 4,
        "ActorName": "[PlayerName]",
        "ActorTalk": "斗殴？"
    },
    {
        "TextId": 5,
        "ActorName": "翠丝",
        "ActorTalk": "我已经在好好反省受罚了。"
    },
    {
        "TextId": 6,
        "ActorName": "翠丝",
        "ActorTalk": "况且，前台招待，这到底是什么处罚嘛……"
    },
    {
        "TextId": 7,
        "ActorName": "翠丝",
        "ActorTalk": "说我的人际交往能力有问题，只会使用暴力，要培养我的沟通能力。"
    },
    {
        "TextId": 8,
        "ActorName": "翠丝",
        "ActorTalk": "我的沟通有问题吗？明明是那小子有问题！"
    },
    {
        "TextId": 9,
        "ActorName": "翠丝",
        "ActorTalk": "不是第一回了！好几次，好几次我都撞见挨揍那家伙偷偷跟踪库洛洛。"
    },
    {
        "TextId": 10,
        "ActorName": "翠丝",
        "ActorTalk": "怎么看都很可疑吧！我只是为了空中花园的安全着想。"
    },
    {
        "TextId": 11,
        "ActorName": "翠丝",
        "ActorTalk": "结果又是一张处罚通知单。"
    },
    {
        "TextId": 12,
        "ActorName": "[PlayerName]",
        "ActorTalk": "至少我看到的你是这样的。我相信，以后也会有更多人发现这样的你。"
    },
    {
        "TextId": 13,
        "ActorName": "翠丝",
        "ActorTalk": "呜……谢谢你，我感觉开心多了。"
    },
    {
        "TextId": 14,
        "ActorTalk": "我相信你做前台也会很优秀。"
    },
    {
        "TextId": 15,
        "ActorTalk": "细心警觉是你的优点。"
    }
]