[
    {
        "TextId": 1,
        "ActorName": "[PlayerName]",
        "ActorTalk": "这里怎么会有两个电梯操作平台。"
    },
    {
        "TextId": 2,
        "ActorName": "布偶熊",
        "ActorTalk": "这个可不是电梯操作台，你把手放上去看看。"
    },
    {
        "TextId": 3,
        "ActorName": "[PlayerName]",
        "ActorTalk": "嗯？居然弹出页面了。"
    },
    {
        "TextId": 4,
        "ActorName": "布偶熊",
        "ActorTalk": "这是我随手做的新程序，可以创造一个虚拟现实世界供适用者进行射击训练。"
    },
    {
        "TextId": 5,
        "ActorName": "布偶熊",
        "ActorTalk": "按理来说应该放在某个战斗模拟室里，不过具体放哪个还在走流程，所以先放外面等有缘人发现咯。"
    },
    {
        "TextId": 6,
        "ActorName": "[PlayerName]",
        "ActorTalk": "放电梯旁边会不会有人误触？"
    },
    {
        "TextId": 7,
        "ActorName": "布偶熊",
        "ActorTalk": "不用担心这一点，我设定好了，只有特定人士可以激活程序。"
    },
    {
        "TextId": 8,
        "ActorName": "[PlayerName]",
        "ActorTalk": "非常人性化。"
    },
    {
        "TextId": 9,
        "ActorName": "[PlayerName]",
        "ActorTalk": "赞你。"
    },
    {
        "TextId": 10,
        "ActorName": "布偶熊",
        "ActorTalk": "当然，你也在特定人士之列。作为享受这个殊荣的人，有没有兴趣陪我一起测一测这个程序？"
    },
    {
        "TextId": 11,
        "ActorName": "[PlayerName]",
        "ActorTalk": "看来是没有理由拒绝了。"
    },
    {
        "TextId": 12,
        "ActorName": "里",
        "ActorTalk": "布偶熊说的地方应该就是这里。"
    },
    {
        "TextId": 13,
        "ActorName": "罗塞塔",
        "ActorTalk": "嗯，指挥官也在这。"
    },
    {
        "TextId": 14,
        "ActorName": "布偶熊",
        "ActorTalk": "二位，是这里没错。"
    },
    {
        "TextId": 15,
        "ActorName": "[PlayerName]",
        "ActorTalk": "里和罗塞塔，你们这是？"
    },
    {
        "TextId": 16,
        "ActorName": "里",
        "ActorTalk": "布偶熊说有新的战斗模拟训练测试，所以我来了。"
    },
    {
        "TextId": 17,
        "ActorName": "罗塞塔",
        "ActorTalk": "我也是，布偶熊女士邀请我来，路上碰见了里先生。"
    },
    {
        "TextId": 18,
        "ActorName": "[PlayerName]",
        "ActorTalk": "接下来我们需要做什么？"
    },
    {
        "TextId": 19,
        "ActorName": "布偶熊",
        "ActorTalk": "进入程序设计的虚拟空间，挑选自己想要的场地，挑好就自动开始。一次训练需要两个人……"
    },
    {
        "TextId": 20,
        "ActorName": "里",
        "ActorTalk": "我和指挥官一组。"
    },
    {
        "TextId": 21,
        "ActorName": "罗塞塔",
        "ActorTalk": "我也是。"
    },
    {
        "TextId": 22,
        "ActorName": "布偶熊",
        "ActorTalk": "那这么决定，指挥官和我们三个轮流对练，指挥官没意见吧。"
    },
    {
        "TextId": 23,
        "ActorName": "[PlayerName]",
        "ActorTalk": "我没意见。"
    },
    {
        "TextId": 24,
        "ActorName": "[PlayerName]",
        "ActorTalk": "那就开始吧。"
    },
    {
        "TextId": 25,
        "ActorName": "[PlayerName]",
        "ActorTalk": "选择和布偶熊对战。"
    },
    {
        "TextId": 26,
        "ActorName": "[PlayerName]",
        "ActorTalk": "选择和里对战。"
    },
    {
        "TextId": 27,
        "ActorName": "[PlayerName]",
        "ActorTalk": "选择和罗塞塔对战。"
    }
]