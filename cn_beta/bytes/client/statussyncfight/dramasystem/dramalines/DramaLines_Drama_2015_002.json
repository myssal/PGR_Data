[
    {
        "TextId": 1,
        "ActorName": "阿尔法",
        "ActorTalk": "等等。",
        "Cv": 510030027
    },
    {
        "TextId": 2,
        "ActorTalk": "怎么了？"
    },
    {
        "TextId": 3,
        "ActorName": "阿尔法",
        "ActorTalk": "这楼里面虽然没几个人，但我不希望太显眼。",
        "Cv": 510030028
    },
    {
        "TextId": 4,
        "ActorTalk": "要不等到人都走了以后行动？"
    },
    {
        "TextId": 5,
        "ActorName": "阿尔法",
        "ActorTalk": "我不打算在这里留太久，你也有自己的事要做吧？",
        "Cv": 510030029
    },
    {
        "TextId": 6,
        "ActorTalk": "那你有没有什么想法？"
    },
    {
        "TextId": 7,
        "ActorName": "阿尔法",
        "ActorTalk": "自然一点，尽量避开人群，注意彼此的脚步，保持方向一致。",
        "Cv": 510030030
    },
    {
        "TextId": 8,
        "ActorName": "阿尔法",
        "ActorTalk": "更简单来说，就是决定谁牵着谁。",
        "Cv": 510030031
    },
    {
        "TextId": 9,
        "ActorTalk": "被牵的人只需要配合就好了对吧？"
    },
    {
        "TextId": 10,
        "ActorName": "阿尔法",
        "ActorTalk": "所以你要怎么决定，走前面，还是后面？",
        "Cv": 510030032
    },
    {
        "TextId": 11,
        "ActorTalk": "那我走前面吧。"
    },
    {
        "TextId": 12,
        "ActorTalk": "那阿尔法走前面吧。"
    },
    {
        "TextId": 13,
        "ActorName": "阿尔法",
        "ActorTalk": "呵，行啊。你是指挥官，在外人看，走在构造体前面也正常。",
        "Cv": 510030033
    },
    {
        "TextId": 14,
        "ActorName": "阿尔法",
        "ActorTalk": "前进路线就由你来决定，走吧。",
        "Cv": 510030034
    },
    {
        "TextId": 15,
        "ActorName": "阿尔法",
        "ActorTalk": "正确的选择，你只管跟上就行。",
        "Cv": 510030035
    }
]