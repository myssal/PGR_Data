[
    {
        "TextId": 1,
        "ActorName": "阿尔法",
        "ActorTalk": "……",
        "Cv": 510030108
    },
    {
        "TextId": 2,
        "ActorTalk": "不知道要等多久。"
    },
    {
        "TextId": 3,
        "ActorTalk": "那些教官似乎还在找我们。"
    },
    {
        "TextId": 4,
        "ActorName": "阿尔法",
        "ActorTalk": "那就不再等了。",
        "Cv": 510030109
    },
    {
        "TextId": 5,
        "ActorName": "阿尔法",
        "ActorTalk": "找到这里也是迟早的事。",
        "Cv": 510030110
    },
    {
        "TextId": 6,
        "ActorTalk": "你想做什么？"
    },
    {
        "TextId": 7,
        "ActorName": "阿尔法",
        "ActorTalk": "从删除数据那刻开始，先前法奥斯对我的各种识别都会解除。",
        "Cv": 510030111
    },
    {
        "TextId": 8,
        "ActorName": "阿尔法",
        "ActorTalk": "再过一阵，就会有很多麻烦的家伙找上门来。",
        "Cv": 510030112
    },
    {
        "TextId": 9,
        "ActorTalk": "应该还有办法。"
    },
    {
        "TextId": 10,
        "ActorTalk": "得先想办法解开手铐。"
    },
    {
        "TextId": 11,
        "ActorName": "阿尔法",
        "ActorTalk": "办法……比如说我斩开法奥斯的天幕，然后带你离开这里。",
        "Cv": 510030123
    },
    {
        "TextId": 12,
        "ActorTalk": "……我不认为这是一个办法。"
    },
    {
        "TextId": 13,
        "ActorName": "阿尔法",
        "ActorTalk": "我不会这么做，因为当时……我也不打算这么做。",
        "Cv": 510030124
    },
    {
        "TextId": 14,
        "ActorName": "阿尔法",
        "ActorTalk": "该舍弃的就要舍弃，该决断的，也应是如此。",
        "Cv": 510030125
    },
    {
        "TextId": 15,
        "ActorName": "阿尔法",
        "ActorTalk": "既然意见没法统一，那要做的，就只有——",
        "Cv": 510030126
    },
    {
        "TextId": 16,
        "ActorName": "阿尔法",
        "ActorTalk": "我斩开了中间的能量流，但出于你的安全考虑，我没有破坏手铐本身。",
        "Cv": 510030127
    },
    {
        "TextId": 17,
        "ActorName": "阿尔法",
        "ActorTalk": "不过这样一来……这手铐上又留下了我的数据和痕迹。",
        "Cv": 510030115
    },
    {
        "TextId": 18,
        "ActorTalk": "我不交出去就好了。"
    },
    {
        "TextId": 19,
        "ActorTalk": "应该不会有什么问题吧。"
    },
    {
        "TextId": 20,
        "ActorName": "阿尔法",
        "ActorTalk": "并不是每件事情都能如你预期那样发展。",
        "Cv": 510030116
    },
    {
        "TextId": 21,
        "ActorName": "阿尔法",
        "ActorTalk": "像你，像那女学生，像之前在这里接触到的其他人，这些都是我此行没能“删除”的痕迹。",
        "Cv": 510030117
    },
    {
        "TextId": 22,
        "ActorTalk": "可不能“删除”人啊。"
    },
    {
        "TextId": 23,
        "ActorTalk": "数据先不说，但与人结交并不是坏事。"
    },
    {
        "TextId": 24,
        "ActorName": "阿尔法",
        "ActorTalk": "人永远是最麻烦的东西，在他人世界留下自己的痕迹，让自己与别人产生联结……",
        "Cv": 510030118
    },
    {
        "TextId": 25,
        "ActorName": "阿尔法",
        "ActorTalk": "不过是徒增烦恼——所以，我才想要尽可能抹去这一切。",
        "Cv": 510030119
    },
    {
        "TextId": 26,
        "ActorTalk": "正因那些痕迹，我们之前才能一起战斗。"
    },
    {
        "TextId": 27,
        "ActorTalk": "正因那些痕迹，那个女学生才会帮助我们。"
    },
    {
        "TextId": 28,
        "ActorName": "阿尔法",
        "ActorTalk": "呵，你还真是爱说这种大话。",
        "Cv": 510030120
    },
    {
        "TextId": 29,
        "ActorName": "阿尔法",
        "ActorTalk": "时间到了，那些人很快就会找上来，到时你就找个理由搪塞过去吧。",
        "Cv": 510030121
    },
    {
        "TextId": 30,
        "ActorTalk": "再见，阿尔法。"
    },
    {
        "TextId": 31,
        "ActorName": "阿尔法",
        "ActorTalk": "我不会说再见的。",
        "Cv": 510030122
    }
]