[
    {
        "TextId": 1,
        "ActorName": "露西亚",
        "ActorTalk": "第一位嫌疑人是埃吉涅小姐，她是工程部队的队员，案发时正在商会仓库附近。",
        "Cv": 510002108
    },
    {
        "TextId": 2,
        "ActorName": "埃吉涅",
        "ActorTalk": "……我叫埃吉涅。",
        "Cv": 510002111
    },
    {
        "TextId": 3,
        "ActorName": "埃吉涅",
        "ActorTalk": "……建筑结构例行检查。",
        "Cv": 510002109
    },
    {
        "TextId": 4,
        "ActorName": "露西亚",
        "ActorTalk": "指挥官，我已经找卡列尼娜确认过了，埃吉涅小姐的证言属实，附近的商家也都曾配合过她进行例行检查。",
        "Cv": 510002110
    },
    {
        "TextId": 5,
        "ActorName": "[PlayerName]",
        "ActorTalk": "……"
    },
    {
        "TextId": 6,
        "ActorName": "埃吉涅",
        "ActorTalk": "……",
        "Cv": 510002112
    },
    {
        "TextId": 7,
        "ActorName": "埃吉涅",
        "ActorTalk": "……放我回去上班。",
        "Cv": 510002113
    },
    {
        "TextId": 8,
        "ActorName": "露西亚",
        "ActorTalk": "第二位嫌疑人是格雷先生，他是弈智桌游社的店长，案发时正在商会仓库周围徘徊。",
        "Cv": 510002116
    },
    {
        "TextId": 9,
        "ActorName": "格雷",
        "ActorTalk": "战无不胜的灰鸦指挥官阁下、英姿飒爽的露西亚小姐，久仰久仰，在下是格雷·阿尔弗雷德，一位在商业区环游的谦卑旅人。",
        "Cv": 510002119
    },
    {
        "TextId": 10,
        "ActorName": "格雷",
        "ActorTalk": "人类的思想宛若荒蛮时代的河床，彼时彼刻，我的灵感之河气竭形枯，不得不四处环游，向缪斯祈求回眸的顾怜。",
        "Cv": 510002117
    },
    {
        "TextId": 11,
        "ActorName": "露西亚",
        "ActorTalk": "……格雷先生当时正在站在仓库前向路人索问“故事素材”，当时商业区的举报热线可以证实他的发言。",
        "Cv": 510002118
    },
    {
        "TextId": 12,
        "ActorName": "露西亚",
        "ActorTalk": "第三位嫌疑人是约斯小姐，她是马克实业的雇工，在案发前曾被目击出现在仓库附近。",
        "Cv": 510002122
    },
    {
        "TextId": 13,
        "ActorName": "约斯",
        "ActorTalk": "我当时是在附近跟顾客沟通货物份额，你们可以去问——",
        "Cv": 510002123
    },
    {
        "TextId": 14,
        "ActorName": "约斯",
        "ActorTalk": "我、我怎么不记得？在哪啊？",
        "Cv": 510002124
    },
    {
        "TextId": 15,
        "ActorName": "约斯",
        "ActorTalk": "啧，倒霉……！",
        "Cv": 510002125
    },
    {
        "TextId": 16,
        "ActorName": "露西亚",
        "ActorTalk": "指挥官，小心——！",
        "Cv": 510002126
    },
    {
        "TextId": 17,
        "ActorName": "[PlayerName]",
        "ActorTalk": "露西亚，从侧面包抄。"
    },
    {
        "TextId": 18,
        "ActorName": "埃吉涅",
        "ActorTalk": "……",
        "Cv": 510002114
    },
    {
        "TextId": 19,
        "ActorName": "露西亚",
        "ActorTalk": "……指挥官，根据附近商家的口供，埃吉涅小姐并不存在作案时间。",
        "Cv": 510002115
    },
    {
        "TextId": 20,
        "ActorName": "格雷",
        "ActorTalk": "噢！！！何等意外的反转！我已经感受到了灵魂黑夜的召唤！诗人即将锒铛入狱，而罪人依旧天涯在逃！",
        "Cv": 510002120
    },
    {
        "TextId": 21,
        "ActorName": "露西亚",
        "ActorTalk": "指挥官，格雷先生虽然言行有些……怪异，但根据多方验证，他应当不具备作案时间。",
        "Cv": 510002121
    },
    {
        "TextId": 22,
        "ActorTalk": "自我介绍一下。"
    },
    {
        "TextId": 23,
        "ActorTalk": "你当时在做什么？"
    },
    {
        "TextId": 24,
        "ActorTalk": "就是你偷了香料！"
    },
    {
        "TextId": 25,
        "ActorTalk": "换下一位吧。"
    },
    {
        "TextId": 26,
        "ActorTalk": "等等……"
    },
    {
        "TextId": 27,
        "ActorTalk": "我是不是在哪里见过你？"
    },
    {
        "TextId": 28,
        "ActorTalk": "你当时在和人讨论丢失的“名单”。"
    },
    {
        "TextId": 29,
        "ActorTalk": "你是芙洛世商会的人。"
    }
]