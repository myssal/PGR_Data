[
    {
        "TextId": 1,
        "ActorName": "赛琳娜",
        "ActorTalk": "现在，我们各用一只手握住它的两端。",
        "Cv": 510027035
    },
    {
        "TextId": 2,
        "ActorName": "赛琳娜",
        "ActorTalk": "听，这样就可以演奏出声音了。",
        "Cv": 510027036
    },
    {
        "TextId": 3,
        "ActorName": "赛琳娜",
        "ActorTalk": "指挥准备好演奏正篇了吗？",
        "Cv": 510027010
    },
    {
        "TextId": 4,
        "ActorName": "赛琳娜",
        "ActorTalk": "指挥，你听，它们是不是很像从天空落下的轻盈雨滴？",
        "Cv": 510027037
    },
    {
        "TextId": 5,
        "ActorName": "赛琳娜",
        "ActorTalk": "一起滴在你和我的身上，让我们同在一场雨里。",
        "Cv": 510027038
    },
    {
        "TextId": 6,
        "ActorName": "赛琳娜",
        "ActorTalk": "在声音产生的时刻，触觉带来的触感与温度，——这些都似乎成为了“声音”的一部分。",
        "Cv": 510027014
    },
    {
        "TextId": 7,
        "ActorName": "赛琳娜",
        "ActorTalk": "在我选择贴近你的时候，还能创作出一段别样的音乐——",
        "Cv": 510027015
    },
    {
        "TextId": 8,
        "ActorTalk": "很有意思。"
    },
    {
        "TextId": 9,
        "ActorName": "赛琳娜",
        "ActorTalk": "这是只有你和我才能读懂的“秘密暗号”。",
        "Cv": 510027016
    }
]