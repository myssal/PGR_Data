[
    {
        "TextId": 1,
        "ActorName": "露西亚",
        "ActorTalk": "你没事就好。",
        "Cv": 510000072
    },
    {
        "TextId": 2,
        "ActorName": "露西亚",
        "ActorTalk": "抱歉，刚刚事发紧急……我以你的安全为最优先，却没有把握好推进器的速度。",
        "Cv": 510000073
    },
    {
        "TextId": 3,
        "ActorName": "露西亚",
        "ActorTalk": "扫描显示，萤火虫就在前面浮空的平台上。",
        "Cv": 510000065
    },
    {
        "TextId": 4,
        "ActorName": "阿呆蛙",
        "ActorTalk": "阿呆蛙的腿太短了，跳不过去呱……",
        "Cv": 510000066
    },
    {
        "TextId": 5,
        "ActorName": "露西亚",
        "ActorTalk": "指挥官，牵住我的手，我带你飞跃过去吧。",
        "Cv": 510000067
    },
    {
        "TextId": 6,
        "ActorName": "露西亚",
        "ActorTalk": "收集到找到金色萤火虫了，指挥官，我们回去——",
        "Cv": 510000068
    },
    {
        "TextId": 7,
        "ActorName": "露西亚",
        "ActorTalk": "指挥官，小心——！",
        "Cv": 510000069
    },
    {
        "TextId": 8,
        "ActorName": "露西亚",
        "ActorTalk": "请抓紧我，指挥官。",
        "Cv": 510000070
    },
    {
        "TextId": 9,
        "ActorName": "露西亚",
        "ActorTalk": "应该没有受伤吧，指挥官？",
        "Cv": 510000071
    },
    {
        "TextId": 10,
        "ActorName": "阿呆蛙",
        "ActorTalk": "森林果然和书里说的一样危险呱！你们有在上面找到金色萤火虫吗？",
        "Cv": 510000074
    },
    {
        "TextId": 11,
        "ActorName": "露西亚",
        "ActorTalk": "阿呆蛙，这个就是你要找的萤火虫吗？",
        "Cv": 510000075
    },
    {
        "TextId": 12,
        "ActorName": "阿呆蛙",
        "ActorTalk": "没错，把它交给阿呆蛙呱。",
        "Cv": 510000076
    },
    {
        "TextId": 13,
        "ActorName": "阿呆蛙",
        "ActorTalk": "接下来，只要将金色萤火虫交给鼹鼠妈妈就好！",
        "Cv": 510000077
    },
    {
        "TextId": 14,
        "ActorName": "阿呆蛙",
        "ActorTalk": "对了呱，到时候可千万不能向鼹鼠妈妈提“循环”的事哦。",
        "Cv": 510000078
    },
    {
        "TextId": 15,
        "ActorName": "露西亚",
        "ActorTalk": "你是在担心什么吗？",
        "Cv": 510000079
    },
    {
        "TextId": 16,
        "ActorName": "阿呆蛙",
        "ActorTalk": "如果鼹鼠妈妈知道了循环的事，她的心愿中就会掺杂了想要帮助阿呆蛙的成分。",
        "Cv": 510000080
    },
    {
        "TextId": 17,
        "ActorName": "阿呆蛙",
        "ActorTalk": "心愿露珠需要保持纯粹，任何不和谐的情绪，都会令它变得浑浊，失去作用。",
        "Cv": 510000081
    },
    {
        "TextId": 18,
        "ActorName": "阿呆蛙",
        "ActorTalk": "而且，阿呆蛙也不想让鼹鼠妈妈担心，阿呆蛙希望她能带着最纯粹的喜悦，迎接心愿实现的那一刻。",
        "Cv": 510000082
    },
    {
        "TextId": 19,
        "ActorName": "阿呆蛙",
        "ActorTalk": "说得有些多了，我们快去把萤火虫交给鼹鼠妈妈吧！",
        "Cv": 510000083
    },
    {
        "TextId": 20,
        "ActorTalk": "我没事。"
    },
    {
        "TextId": 21,
        "ActorTalk": "就是头有些晕……"
    }
]