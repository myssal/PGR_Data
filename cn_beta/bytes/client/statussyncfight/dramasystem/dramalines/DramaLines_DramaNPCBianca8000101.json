[
    {
        "TextId": 1,
        "ActorName": "比安卡",
        "ActorTalk": "指挥官阁下？没想到会在这里遇到您。"
    },
    {
        "TextId": 2,
        "ActorName": "比安卡",
        "ActorTalk": "距离任务出发还有些时间，您找我，是有什么事吗？"
    },
    {
        "TextId": 3,
        "ActorName": "比安卡",
        "ActorTalk": "是的，指挥官阁下。"
    },
    {
        "TextId": 4,
        "ActorName": "比安卡",
        "ActorTalk": "装备和武器都已检查完毕，我只是想在出发之前，在这里整理一下思绪。"
    },
    {
        "TextId": 5,
        "ActorName": "比安卡",
        "ActorTalk": "这里的景色总能让人心绪平和，有助于在行动前保持专注。"
    },
    {
        "TextId": 6,
        "ActorName": "比安卡",
        "ActorTalk": "我确实在思考一些事情，关于信仰、责任与眼前这些需要守护的笑颜。"
    },
    {
        "TextId": 7,
        "ActorName": "比安卡",
        "ActorTalk": "每当看到这片刻的平和，总会让我更加明确挥剑的意义。"
    },
    {
        "TextId": 8,
        "ActorName": "比安卡",
        "ActorTalk": "感谢您的关心，指挥官阁下。"
    },
    {
        "TextId": 9,
        "ActorName": "比安卡",
        "ActorTalk": "感谢您的好意，指挥官阁下。"
    },
    {
        "TextId": 10,
        "ActorName": "比安卡",
        "ActorTalk": "必要的准备已经完成，无需劳烦您。"
    },
    {
        "TextId": 11,
        "ActorName": "比安卡",
        "ActorTalk": "您的关心对我而言，就是最好的支持。"
    },
    {
        "TextId": 12,
        "ActorName": "比安卡",
        "ActorTalk": "好的，指挥官阁下。我这边也差不多要出发了，请您多保重，我们稍后再见。"
    },
    {
        "TextId": 13,
        "ActorTalk": "是在准备任务吗？"
    },
    {
        "TextId": 14,
        "ActorTalk": "你好像在想心事？"
    },
    {
        "TextId": 15,
        "ActorTalk": "需要我帮忙吗？"
    },
    {
        "TextId": 16,
        "ActorTalk": "那我先不打扰了"
    }
