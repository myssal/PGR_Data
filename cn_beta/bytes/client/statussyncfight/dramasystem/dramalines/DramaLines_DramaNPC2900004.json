[
    {
        "TextId": 1,
        "ActorName": "哈特曼教官",
        "ActorTalk": "嗯，没伤没残，你小子不错。现在在哪服役？"
    },
    {
        "TextId": 2,
        "ActorName": "毕业生",
        "ActorTalk": "刚从地表北极执行任务回来呢，那边正是极夜"
    },
    {
        "TextId": 3,
        "ActorName": "毕业生",
        "ActorTalk": "哈哈，无论什么时候打开窗户都是黑夜，就像“法奥斯之夜”那段日子一样。"
    },
    {
        "TextId": 4,
        "ActorName": "哈特曼教官",
        "ActorTalk": "哼，还好意思提法奥斯之夜啊。"
    },
    {
        "TextId": 5,
        "ActorName": "哈特曼教官",
        "ActorTalk": "就是你小子在那时候的军事实训请了全程的假吧？区区一个日夜系统损坏就吓成这样，和现在灰鸦小队的那个毕业生可真是没法比。"
    },
    {
        "TextId": 6,
        "ActorName": "毕业生",
        "ActorTalk": "您拿我和灰鸦指挥官比那也太欺负人了吧，灰鸦指挥官可是我那一届的首席！"
    },
    {
        "TextId": 7,
        "ActorName": "毕业生",
        "ActorTalk": "而且哪只是日夜系统损坏那么简单啊！明明就——"
    },
    {
        "TextId": 8,
        "ActorName": "哈特曼教官",
        "ActorTalk": "呿呿，首不首席的，从咱们法奥斯毕业出去的，标准都得一样。"
    }
]