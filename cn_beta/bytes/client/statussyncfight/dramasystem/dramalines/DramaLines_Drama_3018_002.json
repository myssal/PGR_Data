[
    {
        "TextId": 1,
        "ActorName": "涅缇娅",
        "ActorTalk": "原来这就是老师视角。",
        "Cv": 510036008
    },
    {
        "TextId": 2,
        "ActorName": "涅缇娅",
        "ActorTalk": "从台上看，学生的小动作都藏不住呢。",
        "Cv": 510036009
    },
    {
        "TextId": 3,
        "ActorName": "涅缇娅",
        "ActorTalk": "下次要不要尝试当回老师呢。",
        "Cv": 510036010
    },
    {
        "TextId": 4,
        "ActorName": "涅缇娅",
        "ActorTalk": "小乌鸦，在教室里见到我，意不意外？",
        "Cv": 510036011
    },
    {
        "TextId": 5,
        "ActorTalk": "涅缇娅，看来你那边忙完了。"
    },
    {
        "TextId": 6,
        "ActorName": "涅缇娅",
        "ActorTalk": "应该称呼我为“涅缇娅老师”哦，我的乌鸦小同学。",
        "Cv": 510036012
    },
    {
        "TextId": 7,
        "ActorName": "涅缇娅",
        "ActorTalk": "法奥斯学院近日已正式聘我为名誉信息安全讲师，希望这位同学注意师生礼仪。",
        "Cv": 510036013
    },
    {
        "TextId": 8,
        "ActorTalk": "涅缇娅老师好。"
    },
    {
        "TextId": 9,
        "ActorTalk": "好的，涅缇娅老师。"
    },
    {
        "TextId": 10,
        "ActorName": "涅缇娅",
        "ActorTalk": "不愧是老师们都喜欢的好学生。来，突击检验，老师考考你信息安全课程相关的内容，答对有奖励，答错有惩罚。",
        "Cv": 510036014
    },
    {
        "TextId": 11,
        "ActorName": "涅缇娅",
        "ActorTalk": "你是军人，那我就以“攻城将军容错问题”为例，听题。",
        "Cv": 510036015
    },
    {
        "TextId": 12,
        "ActorTalk": "悉听尊便，接受挑战。"
    },
    {
        "TextId": 13,
        "ActorTalk": "随堂抽查吗？不好的回忆涌上来了……"
    },
    {
        "TextId": 14,
        "ActorName": "涅缇娅",
        "ActorTalk": "判断题，请判断以下描述是否正确。",
        "Cv": 510036016
    },
    {
        "TextId": 15,
        "ActorName": "涅缇娅",
        "ActorTalk": "在部分同步网络模型中，也就是在消息延迟上界未知但最终存在的网络模型中……",
        "Cv": 510036017
    },
    {
        "TextId": 16,
        "ActorTalk": "等等，这和将军没什么关系了吧。"
    },
    {
        "TextId": 17,
        "ActorTalk": "这些词语拼在一起我怎么不认识？"
    },
    {
        "TextId": 18,
        "ActorName": "涅缇娅",
        "ActorTalk": "乌鸦小同学，这是在考验你知识点的活用功能，你不能题目换个表达就不会做了。题目我只念一遍，继续。",
        "Cv": 510036018
    },
    {
        "TextId": 19,
        "ActorName": "涅缇娅",
        "ActorTalk": "在确保其安全性与活性的同时，若要实现一个可容忍f个拜占庭故障、且满足不可变性与一致性的确定下共识协议……",
        "Cv": 510036019
    },
    {
        "TextId": 20,
        "ActorName": "涅缇娅",
        "ActorTalk": "所需的最小节点n不应该小于3f+1，对？还是错？",
        "Cv": 510036020
    },
    {
        "TextId": 21,
        "ActorTalk": "（看来不得不硬着头皮上了。）"
    },
    {
        "TextId": 22,
        "ActorTalk": "这还真是我的擅长领域。"
    },
    {
        "TextId": 23,
        "ActorName": "涅缇娅",
        "ActorTalk": "倒数三个数，三，二……",
        "Cv": 510036021
    },
    {
        "TextId": 24,
        "ActorTalk": "对。"
    },
    {
        "TextId": 25,
        "ActorTalk": "错。"
    },
    {
        "TextId": 26,
        "ActorName": "涅缇娅",
        "ActorTalk": "不错嘛，乌鸦小同学，需要我给你打个高分吗？",
        "Cv": 510036022
    },
    {
        "TextId": 27,
        "ActorTalk": "帮我算平时分里就行。"
    },
    {
        "TextId": 28,
        "ActorTalk": "能算进综测的话最好不过了。"
    },
    {
        "TextId": 29,
        "ActorName": "涅缇娅",
        "ActorTalk": "这道题非常基础，乌鸦小同学需要好好复习一下呢。",
        "Cv": 510036023
    },
    {
        "TextId": 30,
        "ActorTalk": "看起来并不基础。"
    },
    {
        "TextId": 31,
        "ActorTalk": "完全就是欺负人。"
    },
    {
        "TextId": 32,
        "ActorName": "涅缇娅",
        "ActorTalk": "手伸出来，必须小小惩罚一下。",
        "Cv": 510036024
    },
    {
        "TextId": 33,
        "ActorName": "涅缇娅",
        "ActorTalk": "放学后来我办公室，看来有必要对你进行一对一辅导了。",
        "Cv": 510036025
    },
    {
        "TextId": 34,
        "ActorTalk": "就当温故而知新一下吧。"
    },
    {
        "TextId": 35,
        "ActorTalk": "想起来一些不好的回忆了。"
    }
]