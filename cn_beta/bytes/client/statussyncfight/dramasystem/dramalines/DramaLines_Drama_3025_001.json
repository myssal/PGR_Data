[
    {
        "TextId": 1,
        "ActorName": "阿西莫夫",
        "ActorTalk": "【kuroname】，这边。"
    },
    {
        "TextId": 2,
        "ActorTalk": "阿西莫夫？"
    },
    {
        "TextId": 3,
        "ActorTalk": "在搞行为艺术吗？"
    },
    {
        "TextId": 4,
        "ActorName": "阿西莫夫",
        "ActorTalk": "这群库洛洛异常聚集。我想近距离观察，结果库洛洛莫名其妙围成圈，把我夹在里面了。"
    },
    {
        "TextId": 5,
        "ActorName": "阿西莫夫",
        "ActorTalk": "我尝试过推开，但这些库洛洛一推开就会弹回原地。"
    },
    {
        "TextId": 6,
        "ActorName": "阿西莫夫",
        "ActorTalk": "从逻辑上判断，应该是底层控制回路被编入了外部指令。"
    },
    {
        "TextId": 7,
        "ActorTalk": "我怎么帮你？"
    },
    {
        "TextId": 8,
        "ActorName": "阿西莫夫",
        "ActorTalk": "很简单，调用你终端里的「视界探查」，切断这条外部信号链路，拿回它们的默认控制权。"
    },
    {
        "TextId": 9,
        "ActorTalk": "「视界探查」是什么？"
    },
    {
        "TextId": 10,
        "ActorTalk": "我终端里为什么有这个？"
    },
    {
        "TextId": 11,
        "ActorName": "阿西莫夫",
        "ActorTalk": "「视界探查」是为【kuroname】你预留的一套应急模块。"
    },
    {
        "TextId": 12,
        "ActorName": "阿西莫夫",
        "ActorTalk": "在空中花园出现系统异常、常规权限无法介入的情况下，它可以临时接入系统节点，获得控制权限。"
    },
    {
        "TextId": 13,
        "ActorName": "阿西莫夫",
        "ActorTalk": "这套协议目前仍处于研发阶段，既然遇到了这种情况，就刚好用它来测试一下吧。"
    }
]