        "BeginAnim": "AniZhuanchangEnd",
        "Params": [
            "",
            "",
            "他朦胧间想着。"
        ]
    },
    {
        "Id": 59,
        "ActionId": 59,
        "Type": 301,
        "Params": [
            "",
            "",
            "‘日夜更替，四季轮迭，巨龙已死，大陆恢复生机，人们过上了和平且安宁的生活。’"
        ]
    },
    {
        "Id": 60,
        "ActionId": 60,
        "Type": 501,
        "Params": [
            "Assets/Product/Effect/Prefab/FxUi/FxUiStory/FxUiZhuanchangBeginHei.prefab",
