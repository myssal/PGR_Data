        "Duration": 3
    },
    {
        "Id": 1302120704,
        "Type": 3,
        "UiType": 1,
        "Name": "α",
        "Text": "这里会是你的坟墓。",
        "Duration": 3
    },
    {
        "Id": 1302120705,
        "Type": 3,
        "UiType": 1,
        "Name": "“影”",
        "Text": "为什么你还会跟人类站在一起?!",
        "Duration": 3
    },
    {
        "Id": 1302120706,
        "Type": 3,
        "UiType": 1,
        "Name": "α",
        "Text": "别告诉我这么久了，你还在纠结这种事情?",
        "Duration": 3
    },
    {
        "Id": 1302120707,
        "Type": 3,
        "UiType": 1,
        "Name": "“影”",
        "Text": "难道你忘记了过去的背叛吗?!",
        "Duration": 3
    },
    {
        "Id": 1302120708,
        "Type": 3,
        "UiType": 1,
        "Name": "α",
        "Text": "我早已经知晓自己的道路，不会彷徨。",
        "Duration": 3
    },
    {
        "Id": 1302120709,
        "Type": 3,
        "UiType": 1,
        "Name": "“影”",
        "Text": "杀死你之后，我会送那个人类去见你。",
        "Duration": 3
    },
    {
        "Id": 1302120710,
        "Type": 3,
        "UiType": 1,
        "Name": "“影”",
        "Text": "现在的你……还能直视过去的自己吗?",
        "Duration": 3
    },
    {
        "Id": 1302120711,
        "Type": 3,
        "UiType": 1,
        "Name": "“影”",
        "Text": "就让我来为你回忆一下，过往的怨念。",
        "Duration": 3
    },
    {
        "Id": 1302120712,
        "Type": 3,
        "UiType": 1,
        "Name": "幻象·深红囚影",
        "Text": "体验下被自己杀死的感觉吧!",
