    },
    {
        "Id": 1302120713,
        "Type": 3,
        "UiType": 1,
        "Name": "幻象·深红之渊",
        "Text": "一起……被深渊的业火吞噬吧……",
        "Duration": 3
    },
    {
        "Id": 1302120714,
        "Type": 3,
        "UiType": 1,
        "Name": "幻象·深红囚影",
        "Text": "你的结局……也会和我一样……",
        "Duration": 3
    },
    {
        "Id": 1302120715,
        "Type": 3,
        "UiType": 1,
        "Name": "“影”",
        "Text": "回想起过去了吗?",
        "Duration": 3
    },
    {
        "Id": 1302120716,
        "Type": 3,
        "UiType": 1,
        "Name": "α",
        "Text": "我与被仇恨蒙蔽的你不同。",
        "Duration": 3
    },
    {
        "Id": 1302120717,
        "Type": 3,
        "UiType": 1,
        "Name": "α",
        "Text": "你的命运，就在这里终结!",
        "Duration": 3
    },
    {
        "Id": 1302120718,
        "Type": 3,
        "UiType": 1,
        "Name": "“影”",
        "Text": "我的复仇，不能停止!",
        "Duration": 3
    },
    {
        "Id": 1302120719,
        "Type": 3,
        "UiType": 1,
        "Name": "“影”",
        "Text": "我要用你的身体，活下去!让所有人类付出代价!",
        "Duration": 3
    },
    {
        "Id": 1302120720,
        "Type": 3,
        "UiType": 1,
        "Name": "α",
        "Text": "……那就来试试!",
