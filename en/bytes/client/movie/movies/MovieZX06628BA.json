        "ActionId": 4,
        "Type": 301,
        "BeginAnim": "DialogEnable",
        "Params": [
            "",
            "Joanne",
            "Huh? we're recording?! You're not even counting down first?!",
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            "",
