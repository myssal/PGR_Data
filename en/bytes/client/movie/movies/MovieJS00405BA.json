    },
    {
        "Id": 22,
        "ActionId": 22,
        "Type": 304,
        "Params": [
            "Wise, buddy! From now on you'll be representing Team Kalon! Don't let us down!",
            "000000ff",
            "",
            "Assets/Product/Texture/Image/BgStory/BgStory00.png",
            "",
            1
