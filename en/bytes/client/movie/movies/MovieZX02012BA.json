    },
    {
        "Id": 153,
        "ActionId": 156,
        "Type": 301,
        "Params": [
            "",
            "",
            "You look up and find yourself alone in the small room. A few figures stand in the shadow on the other side of the glass window like little demons guarding the gate of hell, trying to feast on those passing by."
        ]
    },
    {
        "Id": 154,
        "ActionId": 157,
        "Type": 302,
        "Params": [
            "",
            "(...Smile wryly)",
            158,
