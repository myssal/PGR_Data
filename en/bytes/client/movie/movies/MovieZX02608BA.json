            1
        ]
    },
    {
        "Id": 128,
        "ActionId": 128,
        "Type": 101,
        "EndAnim": "AniZhuanchangEnd",
        "Params": [
            "Assets/Product/Texture/Image/BgStory/Bgstory350.jpg"
        ]
    },
    {
        "Id": 129,
