        ]
    },
    {
        "Id": 74,
        "ActionId": 73,
        "Type": 301,
        "Params": [
            "",
            "",
            "Following the footprints and the landscape, Pieter analyzes where the trail leads while advancing."
        ]
    },
    {
        "Id": 75,
        "ActionId": 74,
        "Type": 301,
        "Params": [
