    },
    {
        "Id": 64,
        "ActionId": 66,
        "Type": 301,
        "Params": [
            "",
            "Pulao",
            "\"An efficient and objective decision-making AI system based on a constantly updated library of human cognition data.\"—You've heard of this song and dance, right?",
            3
        ]
    },
    {
        "Id": 65,
        "ActionId": 67,
        "Type": 302,
        "Params": [
            "",
            "What's that?",
            68,
