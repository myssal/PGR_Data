    {
        "Id": 118,
        "ActionId": 118,
        "Type": 302,
        "Params": [
            "",
            "Will you believe in miracles, then?",
            119
        ]
    },
    {
        "Id": 119,
        "ActionId": 119,
        "Type": 301,
        "Params": [
            "",
            "Haicma",
            "Why do you keep pushing me to believe in miracles?",
            1
        ]
    },
    {
        "Id": 120,
        "ActionId": 120,
        "Type": 302,
        "Params": [
            "",
            "Because sending you to this conservation area...",
