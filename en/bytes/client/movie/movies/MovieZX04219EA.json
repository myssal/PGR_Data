            "",
            "",
            "",
            "",
            1
        ]
    },
    {
        "Id": 154,
        "ActionId": 155,
        "Type": 301,
        "Params": [
            "",
            "Cradle",
            "These things are known as \"history,\" and history has \"patterns.\"",
            1,
            "",
            "",
            "",
            "",
            "",
            1
        ]
    },
    {
        "Id": 155,
        "ActionId": 156,
        "Type": 301,
        "Params": [
            "",
            "\"The Emperor\"",
            "It's just rhetoric.",
