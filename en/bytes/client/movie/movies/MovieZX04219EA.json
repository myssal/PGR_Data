    },
    {
        "Id": 169,
        "ActionId": 170,
        "Type": 301,
        "Params": [
            "",
            "\"The Emperor\"",
            "You have learned deception.",
            2
        ]
    },
    {
        "Id": 170,
        "ActionId": 171,
        "Type": 301,
        "Params": [
            "",
            "Cradle",
            "I learned that from you.",
            1
        ]
    },
    {
        "Id": 171,
        "ActionId": 172,
        "Type": 301,
        "Params": [
            "",
            "\"The Emperor\"",
            "Do not compare me to humans!",
            2
        ]
    },
    {
        "Id": 172,
        "ActionId": 173,
        "Type": 301,
        "Params": [
            "",
            "\"The Emperor\"",
            "...Here, we part ways.",
            2
        ]
    },
    {
        "Id": 173,
        "ActionId": 174,
        "Type": 301,
        "Params": [
            "",
            "\"The Emperor\"",
