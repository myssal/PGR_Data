    {
        "Id": 48,
        "ActionId": 48,
        "NextActionId": 0,
        "Type": 301,
        "IsBlock": 0,
        "IsEnd": 0,
        "BeginDelay": 0.0,
        "EndDelay": 0.0,
        "Params": [
            "Seeing the machine churn away relentlessly, one can only imagine how the inventor of it must have lost their mind having had to personally process all the documents manually before the machine was invented."
        ]
    },
    {
        "Id": 49,
        "ActionId": 49,
        "NextActionId": 0,
        "Type": 301,
        "IsBlock": 0,
        "IsEnd": 0,
        "BeginDelay": 0.0,
        "EndDelay": 0.0,
        "Params": [
