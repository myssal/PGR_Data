        "Id": 66,
        "ActionId": 65,
        "NextActionId": 0,
        "Type": 301,
        "IsBlock": 0,
        "IsEnd": 0,
        "BeginDelay": 0.0,
        "EndDelay": 0.0,
        "Params": [
            "Bambinata",
            "Why would 【kuroname】 bring Bambinata here? Bambinata doesn't understand.",
            1
        ]
    },
    {
        "Id": 67,
        "ActionId": 66,
        "NextActionId": 0,
        "Type": 302,
        "IsBlock": 0,
        "IsEnd": 0,
        "BeginDelay": 0.0,
        "EndDelay": 0.0,
        "Params": [
            "No reason really.",
            67
        ]
    },
    {
        "Id": 68,
        "ActionId": 67,
        "NextActionId": 0,
        "Type": 301,
        "IsBlock": 0,
        "IsEnd": 0,
        "BeginDelay": 0.0,
        "EndDelay": 0.0,
        "Params": [
            "There is no particular reason indeed. You just brought Bambinata here because you thought this was a comfortable place where you could relax."
