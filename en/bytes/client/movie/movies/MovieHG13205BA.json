    },
    {
        "Id": 5,
        "ActionId": 5,
        "NextActionId": 0,
        "Type": 302,
        "IsBlock": 0,
        "IsEnd": 0,
        "BeginDelay": 0.0,
        "EndDelay": 0.0,
        "Params": [
