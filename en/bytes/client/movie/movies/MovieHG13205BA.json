        "IsBlock": 0,
        "IsEnd": 0,
        "BeginAnim": "DialogEnable",
        "BeginDelay": 0.0,
        "EndDelay": 0.0,
        "Params": [
            "This small, fragile dream all started from a question—"
        ]
    },
    {
        "Id": 32,
        "ActionId": 31,
        "NextActionId": 0,
        "Type": 302,
        "IsBlock": 0,
        "IsEnd": 0,
        "BeginDelay": 0.0,
