            6
        ]
    },
    {
        "Id": 6,
        "ActionId": 6,
        "NextActionId": 0,
        "Type": 301,
        "IsBlock": 0,
        "IsEnd": 0,
        "BeginDelay": 0.0,
        "EndDelay": 0.0,
        "Params": [
            "Simon",
            "The speech you gave just now. I was very impressed, so I borrowed your story.",
            1
        ]
    },
    {
        "Id": 7,
        "ActionId": 7,
        "NextActionId": 0,
        "Type": 301,
        "IsBlock": 0,
        "IsEnd": 0,
        "BeginDelay": 0.0,
        "EndDelay": 0.0,
        "Params": [
            "Simon does a stretch as if he has just come down from the hill and never has to go back up again."
        ]
    },
    {
        "Id": 8,
        "ActionId": 8,
        "NextActionId": 0,
        "Type": 302,
        "IsBlock": 0,
        "IsEnd": 0,
        "BeginDelay": 0.0,
        "EndDelay": 0.0,
        "Params": [
            "I don't think it was that impressive...",
            9
        ]
    },
    {
        "Id": 9,
        "ActionId": 9,
        "NextActionId": 0,
        "Type": 204,
        "IsBlock": 0,
        "IsEnd": 0,
