        "Id": 106,
        "ActionId": 106,
        "Type": 301,
        "EndAnim": "AniZhuanchangBegin",
        "Params": [
            "",
            "Max",
            "You see, Oakley... was a lot smarter and stronger than I could ever hope to be.",
            2
        ]
