    {
        "Id": 129,
        "ActionId": 129,
        "Type": 304,
        "Params": [
            "Ten days ago, following this node's autonomous assessment, the Siren fleet was deployed to the perimeter of the Atlantic Eye.",
            "ffffffff",
            0.8,
            "Assets/Product/Texture/Image/BgStory/BgStory1145.jpg",
            "",
            1
