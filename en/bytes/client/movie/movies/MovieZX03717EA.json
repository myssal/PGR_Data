        "IsBlock": 0,
        "IsEnd": 0,
        "BeginDelay": 0.0,
        "EndDelay": 0.0,
        "Params": [
            "Noctis has visualized fights where he has defeated Nigel more times than he cares to admit—and yet, with Nigel lying defeated in front of him now, Noctis seems to have difficulty wrapping his head around what's happened."
        ]
    },
    {
        "Id": 37,
        "ActionId": 37,
        "NextActionId": 0,
        "Type": 301,
        "IsBlock": 0,
        "IsEnd": 0,
        "BeginDelay": 0.0,
        "EndDelay": 0.0,
        "Params": [
