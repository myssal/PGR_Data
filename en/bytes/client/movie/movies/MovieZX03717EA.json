    },
    {
        "Id": 38,
        "ActionId": 38,
        "NextActionId": 0,
        "Type": 301,
        "IsBlock": 0,
        "IsEnd": 0,
        "BeginDelay": 0.0,
        "EndDelay": 0.0,
        "Params": [
            "Noctis remembers having asked this question before—still, he hopes to hear a different answer from this man who was once a dear friend."
        ]
    },
    {
        "Id": 39,
        "ActionId": 39,
        "NextActionId": 0,
        "Type": 301,
        "IsBlock": 0,
        "IsEnd": 0,
        "BeginDelay": 0.0,
        "EndDelay": 0.0,
        "Params": [
