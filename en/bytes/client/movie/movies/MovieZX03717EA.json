        "IsBlock": 0,
        "IsEnd": 0,
        "BeginDelay": 0.0,
        "EndDelay": 0.0,
        "Params": [
            "Nigel's cloudy eyes close... Noctis has won the fight, one where Nigel himself has given his all and fought in all the ways he knows."
        ]
    },
    {
        "Id": 36,
        "ActionId": 36,
        "NextActionId": 0,
