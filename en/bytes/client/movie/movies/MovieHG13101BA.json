        "IsBlock": 0,
        "IsEnd": 0,
        "BeginAnim": "DialogEnable",
        "BeginDelay": 0.0,
        "EndDelay": 0.0,
        "Params": [
            "Bianca",
            "Of course, Commandant.",
            1
        ]
    },
    {
        "Id": 36,
        "ActionId": 36,
        "NextActionId": 0,
        "Type": 401,
        "IsBlock": 0,
        "IsEnd": 0,
