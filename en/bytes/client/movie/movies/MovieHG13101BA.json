    },
    {
        "Id": 28,
        "ActionId": 28,
        "NextActionId": 0,
        "Type": 301,
        "IsBlock": 0,
        "IsEnd": 0,
        "BeginDelay": 0.0,
        "EndDelay": 0.0,
        "Params": [
            1,
            "Adjusting your breathing, you turn around to look at Bianca."
        ]
    },
    {
        "Id": 29,
        "ActionId": 29,
        "NextActionId": 0,
        "Type": 301,
        "IsBlock": 0,
        "IsEnd": 0,
        "BeginDelay": 0.0,
        "EndDelay": 0.0,
        "Params": [
            "She still has the same awe-inspiring air about her as always, but you can tell that she's genuinely concerned about you."
        ]
    },
    {
        "Id": 30,
        "ActionId": 30,
        "NextActionId": 0,
        "Type": 302,
        "IsBlock": 0,
        "IsEnd": 0,
        "BeginDelay": 0.0,
        "EndDelay": 0.0,
        "Params": [
            "I'm fine, Bianca.",
            31
        ]
    },
    {
        "Id": 31,
        "ActionId": 31,
        "NextActionId": 0,
        "Type": 301,
        "IsBlock": 0,
        "IsEnd": 0,
        "EndAnim": "DialogDisable",
        "BeginDelay": 0.0,
        "EndDelay": 0.0,
        "Params": [
            "Bianca",
            "Let me right away know if anything bothers you physically so we can take care of you with what we have here in the transport craft while we still can.",
            1
        ]
    },
    {
        "Id": 32,
        "ActionId": 32,
        "NextActionId": 0,
        "Type": 302,
        "IsBlock": 0,
        "IsEnd": 0,
        "BeginDelay": 0.0,
        "EndDelay": 0.0,
        "Params": [
            "I'm fine. I was just going through the mission in my head.",
            33
        ]
    },
    {
        "Id": 33,
        "ActionId": 33,
        "NextActionId": 0,
        "Type": 302,
        "IsBlock": 0,
        "IsEnd": 0,
        "BeginDelay": 0.0,
        "EndDelay": 0.0,
        "Params": [
            "Do you mind walking me through the mission again very quickly, Bianca?",
            34
        ]
    },
    {
        "Id": 34,
        "ActionId": 34,
        "NextActionId": 0,
        "Type": 204,
        "IsBlock": 0,
        "IsEnd": 0,
