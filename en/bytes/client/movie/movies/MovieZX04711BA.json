    },
    {
        "Id": 181,
        "ActionId": 181,
        "Type": 301,
        "Params": [
            "",
            "Wanxu",
            "What if... I use a real M.I.N.D.?",
            1
        ]
    },
    {
        "Id": 182,
        "ActionId": 182,
        "Type": 301,
        "Params": [
            "",
            "Wanxu",
            "It's all for Wanshi. Everything I do is for him...",
            1
