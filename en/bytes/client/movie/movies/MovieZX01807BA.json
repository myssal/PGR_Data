        ]
    },
    {
        "Id": 70,
        "ActionId": 68,
        "Type": 301,
        "Params": [
            "",
            "Wanshi",
            "Not long after we received reports of the victory on the front line...",
            1
        ]
    },
    {
        "Id": 71,
        "ActionId": 69,
        "Type": 301,
        "Params": [
            "",
            "Wanshi",
            "The surging Red Tide suddenly went \"inert.\"",
