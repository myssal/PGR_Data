        "ActionId": 42,
        "Type": 301,
        "Params": [
            1,
            "Warren",
            "Dad? Dad, what's happening out there...?",
            1
        ]
    },
    {
        "Id": 43,
        "ActionId": 43,
        "Type": 301,
        "Params": [
            "",
            "Warren",
            "I'm scared... I'm scared...",
            1
        ]
    },
    {
        "Id": 44,
        "ActionId": 44,
        "Type": 301,
        "Params": [
            "",
            "Father's Voice",
            "It's okay... Everything's okay, Warren... Dad's here."
        ]
    },
    {
        "Id": 45,
        "ActionId": 45,
        "Type": 301,
        "Params": [
            "",
            "Father's Voice",
            "I... will protect you."
        ]
    },
    {
        "Id": 46,
        "ActionId": 46,
        "Type": 301,
        "Params": [
            "",
            "Father's Voice",
            "Here, let me stay with you. Just hold me when you sleep if you're afraid."
