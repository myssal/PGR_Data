    {
        "Id": 66,
        "ActionId": 66,
        "Type": 301,
        "Params": [
            1,
            "Theresa",
            "That's enough, Warren. Stop pulling your father's shirt. Dad is going to be away for a while.",
            2
        ]
    },
    {
        "Id": 67,
        "ActionId": 67,
        "Type": 301,
        "Params": [
            "",
            "Warren",
            "Isn't he staying with us?",
            1
        ]
    },
    {
        "Id": 68,
        "ActionId": 68,
        "Type": 301,
        "Params": [
            "",
            "Theresa",
            "No. We'll meet again...",
            2
        ]
    },
