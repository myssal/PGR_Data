        "Type": 301,
        "IsBlock": 0,
        "IsEnd": 0,
        "BeginDelay": 0.0,
        "EndDelay": 0.0,
        "Params": [
            "Celica",
            "Rosetta, is your new frame fully calibrated?",
            11
        ]
    },
    {
        "Id": 42,
        "ActionId": 42,
        "NextActionId": 0,
        "Type": 301,
        "IsBlock": 0,
        "IsEnd": 0,
        "BeginDelay": 0.0,
        "EndDelay": 0.0,
        "Params": [
            "Rosetta",
            "I've completed basic diagnostics. The logistics team advised that, for safety, I remain by 【kuroname】's side. The consciousness connection should help stabilize my M.I.N.D.",
            1
        ]
    },
    {
        "Id": 43,
        "ActionId": 43,
        "NextActionId": 0,
        "Type": 204,
        "IsBlock": 0,
        "IsEnd": 0,
        "BeginDelay": 0.0,
        "EndDelay": 0.0,
