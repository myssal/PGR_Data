    {
        "Id": 38,
        "ActionId": 38,
        "Type": 301,
        "Params": [
            "",
            "Bridget",
            "Bastard...",
            1
        ]
    },
    {
        "Id": 39,
        "ActionId": 39,
        "Type": 301,
        "EndAnim": "DialogDisable",
        "Params": [
            "",
            "",
            "A bitter laugh escapes Bridget's lips as she barely contains a cold sneer between clenched teeth."
