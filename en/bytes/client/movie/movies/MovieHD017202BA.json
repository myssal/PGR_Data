            500138
        ]
    },
    {
        "Id": 61,
        "ActionId": 61,
        "Type": 301,
        "Params": [
            1,
            "Victor",
            "Humans have been hurting one another...",
            1
        ]
    },
    {
        "Id": 62,
        "ActionId": 62,
        "Type": 501,
        "Params": [
            "Assets/Product/Effect/Prefab/FxUi/FxUiStoryNew/FxUiStoryWhiteNew.prefab",
            3
