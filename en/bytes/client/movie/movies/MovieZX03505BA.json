    {
        "Id": 51,
        "ActionId": 52,
        "Type": 301,
        "Params": [
            "",
            "",
            "Just outside the room is a dim but spotless hallway. Giant words written with red paint can just about be seen in the faint xenon light, many parts of the paint having fallen off."
        ]
    },
    {
        "Id": 52,
        "ActionId": 53,
        "Type": 205,
        "EndDelay": 1000.0,
        "Params": [
