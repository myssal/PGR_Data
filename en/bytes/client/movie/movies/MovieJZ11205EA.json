    {
        "Id": 14,
        "ActionId": 13,
        "Type": 301,
        "Params": [
            "",
            "John",
            "Langston... no, I should call you Chrome now. I sent in a request for you especially... You'll be the leader of this outstanding scout team that did not previously belong to any Commandant.",
