    {
        "TextId": 24,
        "ActorName": "Alpha",
        "ActorTalk": "For now.",
        "Cv": 510030099
    },
    {
        "TextId": 25,
        "ActorTalk": "Alpha?"
    },
    {
        "TextId": 26,
        "ActorName": "Alpha",
        "ActorTalk": "...Let's move. We have a window.",
        "Cv": 510030100
