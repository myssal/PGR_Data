[
    {
        "Id": 10201001,
        "Group": 10201,
        "RoleName": "渡边",
        "ChatText": "灰鸦，准备好继续出发了吗？"
    },
    {
        "Id": 10201002,
        "Group": 10201,
        "RoleName": "渡边",
        "ChatText": "昏迷了这么久，不论是精神还是身体，都需要点复健的时间，跟我去附近练练手吧。"
    },
    {
        "Id": 10202001,
        "Group": 10202,
        "RoleName": "渡边",
        "ChatText": "都想起来了？看来恢复得不错。"
    },
    {
        "Id": 10202002,
        "Group": 10202,
        "RoleName": "渡边",
        "ChatText": "要想解决铁殇，首先得先找到钢铁军团的位置，以此为目标展开调查吧。"
    },
    {
        "Id": 10203001,
        "Group": 10203,
        "RoleName": "渡边",
        "ChatText": "谢尔曼堡、滚石谷……的确，我赞同你的推断。"
    },
    {
        "Id": 10203002,
        "Group": 10203,
        "RoleName": "渡边",
        "ChatText": "事不宜迟，我去联络那位旅行商人，做好准备了就来找我吧，我们尽快出发。"
    },
    {
        "Id": 10204001,
        "Group": 10204,
        "RoleName": "渡边",
        "ChatText": "刚刚经历了大战，先稍稍休息一下吧。"
    },
    {
        "Id": 10204002,
        "Group": 10204,
        "RoleName": "渡边",
        "ChatText": "等准备好继续出发了，可以随时回来找我。"
    },
    {
        "Id": 10205001,
        "Group": 10205,
        "RoleName": "渡边",
        "ChatText": "锈轭镇现在被圣堂的军力层层包围，物资日益短缺，局势不容乐观。"
    },
    {
        "Id": 10205002,
        "Group": 10205,
        "RoleName": "渡边",
        "ChatText": "一边解决眼下的威胁，一边思考该如何进攻圣环要塞吧。"
    },
    {
        "Id": 10206001,
        "Group": 10206,
        "RoleName": "渡边",
        "ChatText": "里应外合夺取要塞，这是一个很大胆的计划，但眼下我们恐怕也别无选择。"
    },
    {
        "Id": 10206002,
        "Group": 10206,
        "RoleName": "渡边",
        "ChatText": "接下来势必是场艰苦的决战，等准备好了，就来喊我出发吧。"
    },
    {
        "Id": 10301001,
        "Group": 10301,
        "RoleName": "死亡骑士",
        "ChatText": "醒了，猜猜这是哪里？圣堂和地狱二选一。"
    },
    {
        "Id": 10301002,
        "Group": 10301,
        "RoleName": "死亡骑士",
        "ChatText": "准备好了就出发吧，出去逛逛，有利于搅开你拧成浆糊的神志。"
    },
    {
        "Id": 10302001,
        "Group": 10302,
        "RoleName": "死亡骑士",
        "ChatText": "都想起来了？是时候启动列车，重返地狱了。"
    },
    {
        "Id": 10302002,
        "Group": 10302,
        "RoleName": "死亡骑士",
        "ChatText": "准备好了就来找我，别让我等得太久。"
    },
    {
        "Id": 10303001,
        "Group": 10303,
        "RoleName": "死亡骑士",
        "ChatText": "看起来受圣堂的影响，地狱里会倒映出人间的光景，真是恶心。"
    },
    {
        "Id": 10303002,
        "Group": 10303,
        "RoleName": "死亡骑士",
        "ChatText": "不知道继续拖下去还会发生什么，等休息好了就来找我，我们继续出发。"
    },
    {
        "Id": 10304001,
        "Group": 10304,
        "RoleName": "死亡骑士",
        "ChatText": "事不宜迟，朝那群废物们发起进攻吧。"
    },
    {
        "Id": 10305001,
        "Group": 10305,
        "RoleName": "死亡骑士",
        "ChatText": "阿格龙河深处似乎隐藏着什么秘密，注意戒备，继续前进。"
    },
    {
        "Id": 10306001,
        "Group": 10306,
        "RoleName": "死亡骑士",
        "ChatText": "黑暗越深，腌臜的蝇狗越多……站在我的身边，一步也不许远离。"
    },
    {
        "Id": 10306002,
        "Group": 10306,
        "RoleName": "死亡骑士",
        "ChatText": "跟着我的火焰，朝着亚特兰蒂斯进发吧。"
    },
    {
        "Id": 10307001,
        "Group": 10307,
        "RoleName": "死亡骑士",
        "ChatText": "终于摆脱了那群杂碎……怎么样，还走得动路吗？"
    },
    {
        "Id": 10307002,
        "Group": 10307,
        "RoleName": "死亡骑士",
        "ChatText": "这里是魔堡的最深处，海妲魔女可能就在前面，准备好了就来找我吧。"
    },
    {
        "Id": 10401001,
        "Group": 10401,
        "RoleName": "万事",
        "ChatText": "唔……已经要出发了吗？算了，无论是白天还是黑夜，天色都没有区别。"
    },
    {
        "Id": 10401002,
        "Group": 10401,
        "RoleName": "万事",
        "ChatText": "如果你已经休息好了，我们就起身出发吧。"
    },
    {
        "Id": 10402001,
        "Group": 10402,
        "RoleName": "万事",
        "ChatText": "看来你都想起来了。现在的情况，跟我们第一次见面的时候刚好相反。"
    },
    {
        "Id": 10402002,
        "Group": 10402,
        "RoleName": "万事",
        "ChatText": "还有些记忆想不起来也没关系，在前往孤儿院的路上，我会给你解释清楚前因后果的。"
    },
    {
        "Id": 10403001,
        "Group": 10403,
        "RoleName": "万事",
        "ChatText": "小心一些，我们暂时还不知道这么大批的活死人是从哪里窜出来的。"
    },
    {
        "Id": 10403002,
        "Group": 10403,
        "RoleName": "万事",
        "ChatText": "可能被摩利甘说中了，我们刚好不偏不倚地闯进了部落民的仪式场地。"
    },
    {
        "Id": 10404001,
        "Group": 10404,
        "RoleName": "万事",
        "ChatText": "又是曾经在古堡中闻到过的那股药草气味……"
    },
    {
        "Id": 10404002,
        "Group": 10404,
        "RoleName": "万事",
        "ChatText": "灰鸦，和我站到一起，林中可能还有埋伏。"
    },
    {
        "Id": 10405001,
        "Group": 10405,
        "RoleName": "万事",
        "ChatText": "走吧，一切的答案就在前方。"
    },
    {
        "Id": 10406001,
        "Group": 10406,
        "RoleName": "万事",
        "ChatText": "既然已经走到这里，无论这份答案会带来什么后果，我们也唯有面对了。"
    },
    {
        "Id": 10406002,
        "Group": 10406,
        "RoleName": "万事",
        "ChatText": "灰鸦，谢谢你一直都站在我身边。"
    },
    {
        "Id": 10501001,
        "Group": 10501,
        "RoleName": "莉莉丝",
        "ChatText": "暂时还想不起来发生了什么吗？"
    },
    {
        "Id": 10501002,
        "Group": 10501,
        "RoleName": "莉莉丝",
        "ChatText": "没关系，我已经为阁下规划好下一站的路线了……目标是白马镇。"
    },
    {
        "Id": 10502001,
        "Group": 10502,
        "RoleName": "莉莉丝",
        "ChatText": "嗯……天使们的动向有点不同寻常。"
    },
    {
        "Id": 10502002,
        "Group": 10502,
        "RoleName": "莉莉丝",
        "ChatText": "他们不止是在搜刮从列车里掉下的金币，应该还在探寻着更多。"
    },
    {
        "Id": 10503001,
        "Group": 10503,
        "RoleName": "莉莉丝",
        "ChatText": "多年不见，白马镇上发生了不少改变。"
    },
    {
        "Id": 10503002,
        "Group": 10503,
        "RoleName": "莉莉丝",
        "ChatText": "嗯？你是担心我会产生近乡情怯这种情绪？放心好了，我对这里的回忆才没那么美好。"
    },
    {
        "Id": 10504001,
        "Group": 10504,
        "RoleName": "莉莉丝",
        "ChatText": "血契者，唯独在处理战利品这件事上，希望你不要插手。"
    },
    {
        "Id": 10504002,
        "Group": 10504,
        "RoleName": "莉莉丝",
        "ChatText": "我跟天使之间有一笔旧账要算，而且……我想好好独自品尝胜利的滋味。"
    },
    {
        "Id": 10505001,
        "Group": 10505,
        "RoleName": "莉莉丝",
        "ChatText": "哈哈哈哈，拉斐尔……"
    },
    {
        "Id": 10505002,
        "Group": 10505,
        "RoleName": "莉莉丝",
        "ChatText": "不，没什么，很快我就会让她后悔当时为什么要来招惹我。"
    },
    {
        "Id": 10506001,
        "Group": 10506,
        "RoleName": "莉莉丝",
        "ChatText": "就这样，不要停下，让一切力量都臣服于我！"
    },
    {
        "Id": 10507001,
        "Group": 10507,
        "RoleName": "莉莉丝",
        "ChatText": "血契者……我就明白，你一定会回到我的身边。"
    },
    {
        "Id": 10601001,
        "Group": 10601,
        "RoleName": "渡边",
        "ChatText": "灰鸦，只待你一声令下，我们就按照原定计划出击。"
    },
    {
        "Id": 10601002,
        "Group": 10601,
        "RoleName": "莉莉丝",
        "ChatText": "话说，“摆渡人”你把恶魔也带上来了？"
    },
    {
        "Id": 10601003,
        "Group": 10601,
        "RoleName": "薇拉",
        "ChatText": "能用的都要用上，论对付天使的本领他们可比人类强多了。"
    },
    {
        "Id": 10601004,
        "Group": 10601,
        "RoleName": "万事",
        "ChatText": "无论天使，恶魔，还是……至少现在大家的敌人都是天使。"
    },
    {
        "Id": 10601005,
        "Group": 10601,
        "RoleName": "万事",
        "ChatText": "我们都已经做好准备了，血契者。"
    },
    {
        "Id": 10602001,
        "Group": 10602,
        "RoleName": "渡边",
        "ChatText": "地面上支持我们的人越来越多，灰鸦，该做最后的准备了。"
    },
    {
        "Id": 10603001,
        "Group": 10603,
        "RoleName": "万事",
        "ChatText": "血契者，剩下的就只有攻上圣堂了。"
    },
    {
        "Id": 10603002,
        "Group": 10603,
        "RoleName": "薇拉",
        "ChatText": "我没意见，思考，计谋，这些都交给你们，我只要和列车一起给天使们带去死亡就行。"
    },
    {
        "Id": 10603003,
        "Group": 10603,
        "RoleName": "莉莉丝",
        "ChatText": "话说，不先来干一杯吗，各位？"
    },
    {
        "Id": 10604001,
        "Group": 10604,
        "RoleName": "莉莉丝",
        "ChatText": "这是把能打开的星门都用在这里了吗，真是壮观。"
    },
    {
        "Id": 10604002,
        "Group": 10604,
        "RoleName": "万事",
        "ChatText": "得想办法，我们不能让更多天使登上这辆列车了。"
    },
    {
        "Id": 10604003,
        "Group": 10604,
        "RoleName": "薇拉",
        "ChatText": "不管上来没上来，统统杀了就是，灰鸦，准备好了吧！"
    },
    {
        "Id": 10605001,
        "Group": 10605,
        "RoleName": "莉莉丝",
        "ChatText": "你们察觉到了吗，这列车已经不行了。"
    },
    {
        "Id": 10605002,
        "Group": 10605,
        "RoleName": "万事",
        "ChatText": "血契者，我们得在坠落之前找到安全的位置。"
    },
    {
        "Id": 10701001,
        "Group": 10701,
        "RoleName": "涅缇娅",
        "ChatText": "嘘……不必焦急。"
    },
    {
        "Id": 10701002,
        "Group": 10701,
        "RoleName": "涅缇娅",
        "ChatText": "从现在开始，我会将这个世界的真相全部向你娓娓道来。"
    },
    {
        "Id": 10702001,
        "Group": 10702,
        "RoleName": "涅缇娅",
        "ChatText": "没错，你应该早就意识到了，其实你就是那位“灰鸦”。"
    },
    {
        "Id": 10702002,
        "Group": 10702,
        "RoleName": "涅缇娅",
        "ChatText": "烬土边疆人民口中的那位，可以替他们终结一切灾厄的，无所不能的大英雄。"
    },
    {
        "Id": 10703001,
        "Group": 10703,
        "RoleName": "涅缇娅",
        "ChatText": "你看，在这片大陆上，苦厄和灾难从未改变过，是吧？"
    },
    {
        "Id": 10703002,
        "Group": 10703,
        "RoleName": "涅缇娅",
        "ChatText": "我也不明白从未经历过那些日子的人类，如今在缅怀过去些什么。"
    },
    {
        "Id": 10704001,
        "Group": 10704,
        "RoleName": "涅缇娅",
        "ChatText": "灰鸦，我相信，陪伴我一路走到至今的你，一定会作出正确的选择……"
    },
    {
        "Id": 10705001,
        "Group": 10705,
        "RoleName": "涅缇娅",
        "ChatText": "跟我预想中的一模一样，“新世界”是如此的美丽……"
    },
    {
        "Id": 10705002,
        "Group": 10705,
        "RoleName": "涅缇娅",
        "ChatText": "很高兴你能跟我一起见证到这幅美景，我的血契者。"
    },
    {
        "Id": 10706001,
        "Group": 10706,
        "RoleName": "涅缇娅",
        "ChatText": "前进吧，这片大陆上已经不存在任何可以阻拦我们的人了。"
    },
    {
        "Id": 10706002,
        "Group": 10706,
        "RoleName": "涅缇娅",
        "ChatText": "开枪吧，把他们都化作我们的“盟友”。"
    },
    {
        "Id": 10707001,
        "Group": 10707,
        "RoleName": "灰鸦",
        "ChatText": "不，涅缇娅，你是错的！"
    },
    {
        "Id": 10707002,
        "Group": 10707,
        "RoleName": "灰鸦",
        "ChatText": "这个选择只会让整个世界走向另一个终焉！"
    },
    {
        "Id": 20001001,
        "Group": 20001,
        "RoleName": "涅缇娅",
        "ChatText": "想要和我聊聊天？好哦，我一直都在这里，陪你多久都可以。"
    },
    {
        "Id": 20002001,
        "Group": 20002,
        "RoleName": "涅缇娅",
        "ChatText": "在你践行使命的旅途中，我会守望在道路的起点，静候你的凯旋。"
    },
    {
        "Id": 20003001,
        "Group": 20003,
        "RoleName": "涅缇娅",
        "ChatText": "累了就先进屋休息一下吧，我准备了些茶点，都是你喜欢的口味。"
    },
    {
        "Id": 20004001,
        "Group": 20004,
        "RoleName": "雕像",
        "ChatText": "已无人回应"
    }
]