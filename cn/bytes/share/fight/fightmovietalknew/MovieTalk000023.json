    },
    {
        "Id": 13020901,
        "Type": 3,
        "UiType": 1,
        "Name": "罗塞塔",
        "Text": "我……我没问题，【kuroname】，我让我休息一下就好。",
        "Duration": 8,
        "IsMask": false
    },
    {
        "Id": 13020902,
        "Type": 3,
        "UiType": 1,
        "Name": "指挥官",
        "Text": "之前的外伤状况没有恶化，罗塞塔，你还会看见幻觉是吗？",
        "Duration": 3,
        "IsMask": false
    },
    {
        "Id": 13020903,
        "Type": 3,
        "UiType": 1,
        "Name": "指挥官",
        "Text": "可能意识海的伤势加剧了，现在也只能等返回空中花园再维护了。",
        "Duration": 3,
        "IsMask": false
    },
    {
        "Id": 13020904,
        "Type": 3,
        "UiType": 1,
        "Name": "罗塞塔",
        "Text": "不用担心，只是些小伤而已，不会影响我们的撤离计划的。",
        "Duration": 9,
        "IsMask": false
    },
    {
        "Id": 13020905,
        "Type": 3,
        "UiType": 1,
        "Name": "罗塞塔",
        "Text": "暴风雪还没到最猛烈的时候，【kuroname】先坐过来休息一会儿吧。",
        "Duration": 9,
        "IsMask": false
    },
    {
        "Id": 13020906,
        "Type": 3,
        "UiType": 1,
        "Name": "指挥官",
        "Text": "罗塞塔，再梳理一遍我们的撤离计划吧。",
        "Duration": 3,
        "IsMask": false
    },
    {
        "Id": 13020907,
        "Type": 3,
        "UiType": 1,
        "Name": "罗塞塔",
        "Text": "凭借暴风雪的掩护，在风雪中和敌人周旋，完成撤离。",
        "Duration": 7,
        "IsMask": false
    },
    {
        "Id": 13020908,
        "Type": 3,
        "UiType": 1,
        "Name": "罗塞塔",
        "Text": "【kuroname】的计划很大胆……但我赞同。",
        "Duration": 6,
        "IsMask": false
    },
    {
        "Id": 13020909,
        "Type": 3,
        "UiType": 1,
        "Name": "指挥官",
        "Text": "暴风雪不是完全站在我们这一边的，我们也需要做好在其中失散的最坏打算。",
        "Duration": 3,
        "IsMask": false
    },
    {
        "Id": 13020910,
        "Type": 3,
        "UiType": 1,
        "Name": "罗塞塔",
        "Text": "如果……我们也失散了，不要相互寻找，万一撞上风雪中巡逻的敌人……",
        "Duration": 11,
        "IsMask": false
    },
    {
        "Id": 13020911,
        "Type": 3,
        "UiType": 1,
        "Name": "罗塞塔",
        "Text": "太危险了……各自向着撤离点前进吧，【kuroname】我们一定会在那里相见的。",
        "Duration": 10,
        "IsMask": false
    },
    {
        "Id": 13020912,
        "Type": 3,
        "UiType": 1,
        "Name": "指挥官",
        "Text": "再检查一下通讯吧，如果我们失散了，至少还可以保持联络。罗塞塔，声音清晰吗？",
        "Duration": 3,
        "IsMask": false
    },
    {
        "Id": 13020913,
        "Type": 3,
        "UiType": 1,
        "Name": "罗塞塔",
        "Text": "很清晰，通讯也很稳定。就像是【kuroname】在我耳边说话一样。",
        "Duration": 8,
        "IsMask": false
    },
    {
        "Id": 13020914,
        "Type": 3,
        "UiType": 1,
        "Name": "指挥官",
        "Text": "距离出发还有一段时间，罗塞塔，先好好休息保存一下体力吧。",
        "Duration": 3,
        "IsMask": false
    },
    {
        "Id": 13020915,
        "Type": 3,
        "UiType": 1,
        "Name": "罗塞塔",
        "Text": "嗯，【kuroname】也要好好休息啊。",
        "Duration": 6,
        "IsMask": false
    },
    {
        "Id": 13020916,
        "Type": 3,
        "UiType": 1,
        "Name": "罗塞塔",
        "Text": "【kuroname】……再靠近一点……风雪好大……请抱紧我……",
        "Duration": 16,
        "IsMask": false
    },
    {
        "Id": 13020917,
        "Type": 3,
        "UiType": 1,
        "Name": "罗塞塔",
        "Text": "【kuroname】……很温暖……",
        "Duration": 10,
        "IsMask": false
    },
    {
        "Id": 13020918,
        "Type": 3,
        "UiType": 1,
        "Name": "罗塞塔",
        "Text": "【kuroname】，我刚才好像做了个梦……",
        "Duration": 11,
        "IsMask": false
    },
    {
        "Id": 13020919,
        "Type": 3,
        "UiType": 1,
        "Name": "罗塞塔",
        "Text": "抱歉，【kuroname】，现在什么时候了？",
        "Duration": 6,
        "IsMask": false
    },
    {
        "Id": 13020920,
        "Type": 3,
        "UiType": 1,
        "Name": "指挥官",
        "Text": "休息好了吗？现在暴风雪大起来了，正是我们出发的好时候。",
        "Duration": 5,
        "IsMask": false
    },
    {
        "Id": 13020921,
        "Type": 3,
        "UiType": 1,
        "Name": "指挥官",
        "Text": "（看来罗塞塔的伤势已经影响她行动了，得尽快完成撤离。）",
        "Duration": 3,
        "IsMask": false
    },
    {
        "Id": 13020922,
        "Type": 3,
        "UiType": 1,
        "Name": "指挥官",
        "Text": "来，扶住我。",
        "Duration": 3,
        "IsMask": false
    },
    {
        "Id": 13020923,
        "Type": 3,
        "UiType": 1,
        "Name": "罗塞塔",
        "Text": "【kuroname】……多谢。",
        "Duration": 5,
        "IsMask": false
    },
    {
        "Id": 13020924,
        "Type": 3,
        "UiType": 1,
        "Name": "罗塞塔",
        "Text": "要是……推进器没损坏……就好了……",
        "Duration": 7,
        "IsMask": false
    },
    {
        "Id": 13020925,
        "Type": 3,
        "UiType": 1,
        "Name": "指挥官",
        "Text": "没有的事，没有推进器我们也到这里了不是吗？",
        "Duration": 3,
        "IsMask": false
    },
    {
        "Id": 13020926,
        "Type": 3,
        "UiType": 1,
        "Name": "指挥官",
        "Text": "是因为有罗塞塔和我相互扶持，我们才能坚持到这里不是吗？",
        "Duration": 3,
        "IsMask": false
    },
    {
        "Id": 13020927,
        "Type": 3,
        "UiType": 1,
        "Name": "罗塞塔",
        "Text": "可是……风雪更大了，我们计划的行程还……不到四分之一……",
        "Duration": 12,
        "IsMask": false
    },
    {
        "Id": 13020928,
        "Type": 3,
        "UiType": 1,
        "Name": "罗塞塔",
        "Text": "这样下去不行的，【kuroname】你先撤离吧，……我……我会追上你的。",
        "Duration": 16,
        "IsMask": false
    },
    {
        "Id": 13020929,
        "Type": 3,
        "UiType": 1,
        "Name": "指挥官",
        "Text": "说什么呢，我们要一起返回空中花园的，再坚持一下吧，罗塞塔。",
        "Duration": 3,
        "IsMask": false
    },
    {
        "Id": 13020930,
        "Type": 3,
        "UiType": 1,
        "Name": "指挥官",
        "Text": "这已经是最后一段路了，不远处就是撤离点了。",
        "Duration": 3,
        "IsMask": false
    },
    {
        "Id": 13020931,
        "Type": 3,
        "UiType": 1,
        "Name": "罗塞塔",
        "Text": "好……我会坚持住，和【kuroname】一起抵达撤离点的。",
        "Duration": 14,
        "IsMask": false
    },
    {
        "Id": 13020932,
        "Type": 3,
        "UiType": 1,
        "Name": "机械体A",
        "Text": "有目标足迹？雪暴环境并不适合人类行动，大概率还没走远。",
        "Duration": 10,
        "IsMask": false
    },
    {
        "Id": 13020933,
        "Type": 3,
        "UiType": 1,
        "Name": "罗塞塔",
        "Text": "可恶，居然在这个时候撞上了追兵……【kuroname】，我们……",
        "Duration": 8,
        "IsMask": false
    },
    {
        "Id": 13020934,
        "Type": 3,
        "UiType": 1,
        "Name": "指挥官",
        "Text": "敌人还没发现我们，先寻找掩体躲藏一下吧。",
        "Duration": 3,
        "IsMask": false
    },
    {
        "Id": 13020935,
        "Type": 3,
        "UiType": 1,
        "Name": "指挥官",
        "Text": "这里很隐蔽，应该不会被发现。",
        "Duration": 3,
        "IsMask": false
    },
    {
        "Id": 13020936,
        "Type": 3,
        "UiType": 1,
        "Name": "罗塞塔",
        "Text": "……，【kuroname】你也快躲进来。",
        "Duration": 7,
        "IsMask": false
    },
    {
        "Id": 13020937,
        "Type": 3,
        "UiType": 1,
        "Name": "指挥官",
        "Text": "稍等一下，不要发出声响，我去观察一下敌人动向。",
        "Duration": 4,
        "IsMask": false
    },
    {
        "Id": 13020938,
        "Type": 3,
        "UiType": 1,
        "Name": "机械体A",
        "Text": "足迹朝那个方向去了，你去搜索一下那片区域。",
        "Duration": 5,
        "IsMask": false
    },
    {
        "Id": 13020939,
        "Type": 3,
        "UiType": 1,
        "Name": "机械体B",
        "Text": "这种暴风雪天气，人类怎么可能出来行动……",
        "Duration": 6,
        "IsMask": false
    },
    {
        "Id": 13020940,
        "Type": 3,
        "UiType": 1,
        "Name": "机械体B",
        "Text": "嗯?",
        "Duration": 2,
        "IsMask": false
    },
    {
        "Id": 13020941,
        "Type": 3,
        "UiType": 1,
        "Name": "指挥官",
        "Text": "太紧张了吗，放心把手搭在上面吧。",
        "Duration": 3,
        "IsMask": false
    },
    {
        "Id": 13020942,
        "Type": 3,
        "UiType": 1,
        "Name": "罗塞塔",
        "Text": "……",
        "Duration": 9,
        "IsMask": false
    },
    {
        "Id": 13020943,
        "Type": 3,
        "UiType": 1,
        "Name": "指挥官",
        "Text": "走远了，刚才真是危险，我们继续前进吧。",
        "Duration": 3,
        "IsMask": false
    },
    {
        "Id": 13020944,
        "Type": 3,
        "UiType": 1,
        "Name": "罗塞塔",
        "Text": "【kuroname】，我好一些了，后面的路，我可以自己走的。",
        "Duration": 8,
        "IsMask": false
    },
    {
        "Id": 13020945,
        "Type": 3,
        "UiType": 1,
        "Name": "罗塞塔",
        "Text": "唔……刚才抱的姿势维持的有些久了，腿……有点麻。",
        "Duration": 10,
        "IsMask": false
    },
    {
        "Id": 13020946,
        "Type": 3,
        "UiType": 1,
        "Name": "指挥官",
        "Text": "风还是太大了，罗塞塔跟在我身后就好，风力应该会小一点。",
        "Duration": 4,
        "IsMask": false
    },
    {
        "Id": 13020947,
        "Type": 3,
        "UiType": 1,
        "Name": "指挥官",
        "Text": "罗塞塔，你还好吗？要不要再休息一下？",
        "Duration": 3,
        "IsMask": false
    },
    {
        "Id": 13020948,
        "Type": 3,
        "UiType": 1,
        "Name": "罗塞塔",
        "Text": "没事的……【kuroname】我还能坚持，我们继续前进吧。",
        "Duration": 9,
        "IsMask": false
    },
    {
        "Id": 13020949,
        "Type": 3,
        "UiType": 1,
        "Name": "指挥官",
        "Text": "罗塞塔，你感觉到了没有，风好像小了一点？",
        "Duration": 5,
        "IsMask": false
    },
    {
        "Id": 13020950,
        "Type": 3,
        "UiType": 1,
        "Name": "指挥官",
        "Text": "现在路程已经一半了，再坚持一会儿就要到撤离点了。",
        "Duration": 5,
        "IsMask": false
    },
    {
        "Id": 13020951,
        "Type": 3,
        "UiType": 1,
        "Name": "指挥官",
        "Text": "罗塞塔，如果你需要休息的话随时跟我说……",
        "Duration": 5,
        "IsMask": false
    },
    {
        "Id": 13020952,
        "Type": 3,
        "UiType": 1,
        "Name": "指挥官",
        "Text": "嘘……！前面好像有敌人。",
        "Duration": 3,
        "IsMask": false
    },
    {
        "Id": 13020953,
        "Type": 3,
        "UiType": 1,
        "Name": "指挥官",
        "Text": "停一下，前面好像有敌人。",
        "Duration": 3,
        "IsMask": false
    },
    {
        "Id": 2171401,
        "Type": 3,
        "UiType": 1,
        "Name": "神威",
        "Text": "我绝不会让太阳陨落……",
        "Duration": 99,
        "IsMask": false
    },
    {
        "Id": 2171402,
        "Type": 3,
        "UiType": 1,
        "Name": "神威",
        "Text": "这里，也不会是我们旅途的终点！",
        "Duration": 99,
        "IsMask": false
    },
    {
        "Id": 2171403,
        "Type": 3,
        "UiType": 1,
        "Name": "亚伯",
        "Text": "敌人实在太多了，我真的撑不下去了……",
        "Duration": 99,
        "IsMask": false
    },
    {
        "Id": 2171404,
        "Type": 3,
        "UiType": 1,
        "Name": "神威",
        "Text": "不可以在这里停下！相信我，我一定能带你们冲出去！",
        "Duration": 99,
        "IsMask": false
    },
    {
        "Id": 2171405,
        "Type": 3,
        "UiType": 1,
        "Name": "卡萝",
        "Text": "是神威！你的力量变强了？太好了，我们有救了！",
        "Duration": 99,
        "IsMask": false
    },
    {
        "Id": 2171406,
        "Type": 3,
        "UiType": 1,
        "Name": "神威",
        "Text": "放心交给我，我会成为你们的力量！",
        "Duration": 99,
        "IsMask": false
    },
    {
        "Id": 2171407,
        "Type": 3,
        "UiType": 1,
        "Name": "神威",
        "Text": "大家跟在我身后，我们一起去救其他被困住的人。",
        "Duration": 99,
        "IsMask": false
    },
    {
        "Id": 2171408,
        "Type": 3,
        "UiType": 1,
        "Name": "神威",
        "Text": "对不起……我们来得太迟了。",
        "Duration": 99,
        "IsMask": false
    },
    {
        "Id": 2171409,
        "Type": 3,
        "UiType": 1,
        "Name": "达伦",
        "Text": "神威……我们出不去了……你快带着剩下的人……走……",
        "Duration": 99,
        "IsMask": false
    },
    {
        "Id": 2171410,
        "Type": 3,
        "UiType": 1,
        "Name": "亚伯",
        "Text": "凯！！坚持住！！我们立刻就过来帮你！",
        "Duration": 99,
        "IsMask": false
    },
    {
        "Id": 2171411,
        "Type": 3,
        "UiType": 1,
        "Name": "凯",
        "Text": "敌人太多了，别管我们！带上能源，你们快走啊！！",
        "Duration": 99,
        "IsMask": false
    },
    {
        "Id": 2171412,
        "Type": 3,
        "UiType": 1,
        "Name": "神威",
        "Text": "不！我们不会放弃任何一个家人！",
        "Duration": 99,
        "IsMask": false
    },
    {
        "Id": 2171413,
        "Type": 3,
        "UiType": 1,
        "Name": "神威",
        "Text": "来啊！！有本事就一起上，看我把你们全部都撕碎掉！",
        "Duration": 99,
        "IsMask": false
    },
    {
        "Id": 2172201,
        "Type": 3,
        "UiType": 1,
        "Name": "阿撒尔",
        "Text": "神威，你终于回到我们的家了……",
        "Duration": 99,
        "IsMask": false
    },
    {
        "Id": 2172202,
        "Type": 3,
        "UiType": 1,
        "Name": "神威",
        "Text": "没错，既然你回不了头，那就让我来完成“处决”。",
        "Duration": 99,
        "IsMask": false
    },
    {
        "Id": 2172203,
        "Type": 3,
        "UiType": 1,
        "Name": "神威",
        "Text": "为什么要这么做？你怎么忍心伤害他们？！",
        "Duration": 99,
        "IsMask": false
    },
    {
        "Id": 2172204,
        "Type": 3,
        "UiType": 1,
        "Name": "阿撒尔",
        "Text": "是我为他们带来了解脱啊。因为我，我们的家才能永不分离！",
        "Duration": 99,
        "IsMask": false
    },
    {
        "Id": 2172205,
        "Type": 3,
        "UiType": 1,
        "Name": "阿撒尔",
        "Text": "现在就差你了，神威！",
        "Duration": 99,
        "IsMask": false
    },
    {
        "Id": 2172206,
        "Type": 3,
        "UiType": 1,
        "Name": "阿撒尔",
        "Text": "叛徒！是你遗忘了我们，是你抛弃了我们！",
        "Duration": 99,
        "IsMask": false
    },
    {
        "Id": 2172207,
        "Type": 3,
        "UiType": 1,
        "Name": "神威",
        "Text": "背叛了大家还执迷不悟的人——明明是你！",
        "Duration": 99,
        "IsMask": false
    },
    {
        "Id": 2172208,
        "Type": 3,
        "UiType": 1,
        "Name": "阿撒尔",
        "Text": "就这点本事？",
        "Duration": 99,
        "IsMask": false
    },
    {
        "Id": 2172209,
        "Type": 3,
