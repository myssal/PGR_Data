            1
        ]
    },
    {
        "Id": 10,
        "ActionId": 10,
        "Type": 301,
        "Params": [
            "",
            "神威",
            "是你自己先将大家拉到无路可走的悬崖，逼着他们跳下去，却反过来指责这个世界没有为你留出道路。",
            1
        ]
