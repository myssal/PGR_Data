[
    {
        "TextId": 1,
        "ActorName": "阿西莫夫",
        "ActorTalk": "你读到了什么内容？"
    },
    {
        "TextId": 2,
        "ActorTalk": "（描述监控里看到的画面）"
    },
    {
        "TextId": 3,
        "ActorName": "阿西莫夫",
        "ActorTalk": "你是说，一个工程师在库洛洛旁边徘徊……然后它们就开始移动、列队……"
    },
    {
        "TextId": 4,
        "ActorName": "阿西莫夫",
        "ActorTalk": "嫌疑很大……"
    },
    {
        "TextId": 5,
        "ActorName": "阿西莫夫",
        "ActorTalk": "调查地面留下的脚印吧，如果他在这里徘徊，地面上就一定留有杂乱的脚印信息，我们可以通过这个找到他。"
    },
    {
        "TextId": 6,
        "ActorTalk": "怎么找？"
    },
    {
        "TextId": 7,
        "ActorTalk": "还有这种功能？"
    },
    {
        "TextId": 8,
        "ActorName": "阿西莫夫",
        "ActorTalk": "没错，视界探查里还集成了一个追踪协议。"
    },
    {
        "TextId": 9,
        "ActorName": "阿西莫夫",
        "ActorTalk": "别那么惊讶，测试版的系统搭载一些灰度功能很正常，我会在后续的版本更新相应隐私条款的……"
    },
    {
        "TextId": 10,
        "ActorName": "阿西莫夫",
        "ActorTalk": "总之……扫描库洛洛周围的环境残留，找到嫌疑人留下的线索吧。"
    }
]