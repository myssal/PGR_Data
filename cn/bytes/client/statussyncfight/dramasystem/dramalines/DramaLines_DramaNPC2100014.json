[
    {
        "TextId": 1,
        "ActorName": "[PlayerName]",
        "ActorTalk": "遇到什么难题了吗？"
    },
    {
        "TextId": 2,
        "ActorName": "桑蒂斯",
        "ActorTalk": "是灰鸦指挥官~！唔……要用这么小儿科的烦恼麻烦您吗？"
    },
    {
        "TextId": 3,
        "ActorName": "桑蒂斯",
        "ActorTalk": "是这样，我遇到选择困难症了。"
    },
    {
        "TextId": 4,
        "ActorName": "桑蒂斯",
        "ActorTalk": "萌芽展的《并非终章》采用了我小时候的作品，《演变中的新皮乌斯风格》要陈列艾拉小姐的新作，过一阵它们会同期陈展，我超级期待。"
    },
    {
        "TextId": 5,
        "ActorName": "桑蒂斯",
        "ActorTalk": "但……现在正在陈展的《回眸》我也很想去看。"
    },
    {
        "TextId": 6,
        "ActorName": "桑蒂斯",
        "ActorTalk": "可我手里只有一张工程部队的福利套票，只能用一次。该用在哪场呢？"
    },
    {
        "TextId": 7,
        "ActorName": "[PlayerName]",
        "ActorTalk": "我记得《回眸》是常设展，应该是随时都能免费游览的，你不用做选择。"
    },
    {
        "TextId": 8,
        "ActorName": "桑蒂斯",
        "ActorTalk": "对哦，我真是太迷糊了……那我可以现在去看《回眸》，到时候再用套票游览特展。"
    },
    {
        "TextId": 9,
        "ActorName": "桑蒂斯",
        "ActorTalk": "套票……诶？？？我的福利套票呢？刚才还在呢！！"
    },
    {
        "TextId": 10,
        "ActorTalk": "可能忘在哪了？快去找找吧。"
    },
    {
        "TextId": 11,
        "ActorTalk": "我好像在某个售货机旁边看到过。"
    },
    {
        "TextId": 12,
        "ActorName": "桑蒂斯",
        "ActorTalk": "呜……今天真是太太太迷糊了。"
    }
]