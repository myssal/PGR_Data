[
    {
        "TextId": 1,
        "ActorName": "泰勒维尔",
        "ActorTalk": "中央电梯的设计原来是这样……"
    },
    {
        "TextId": 2,
        "ActorName": "泰勒维尔",
        "ActorTalk": "终于能看懂你了，真是令人心潮澎湃。"
    },
    {
        "TextId": 3,
        "ActorName": "[PlayerName]",
        "ActorTalk": "看来你是真的很热爱这份工作。"
    },
    {
        "TextId": 4,
        "ActorName": "泰勒维尔",
        "ActorTalk": "当然，中央电梯毕竟是和我朝夕相处的老伙计。"
    },
    {
        "TextId": 5,
        "ActorName": "泰勒维尔",
        "ActorTalk": "我是从管理员做起的，和她的感情还挺深厚。"
    },
    {
        "TextId": 6,
        "ActorName": "[PlayerName]",
        "ActorTalk": "而现在你成为了工程师。"
    },
    {
        "TextId": 7,
        "ActorName": "泰勒维尔",
        "ActorTalk": "知其然，还要知其所以然嘛。"
    },
    {
        "TextId": 8,
        "ActorName": "泰勒维尔",
        "ActorTalk": "何况之前空中花园差点坠落，电梯故障时我束手无策。这种滋味，不好受。"
    },
    {
        "TextId": 9,
        "ActorName": "泰勒维尔",
        "ActorTalk": "如果我一开始就知道怎么维修电梯的话，可以让损失变得更小。"
    },
    {
        "TextId": 10,
        "ActorName": "泰勒维尔",
        "ActorTalk": "就是自学的过程比较累哈哈。"
    },
    {
        "TextId": 11,
        "ActorName": "[PlayerName]",
        "ActorTalk": "工作之余自学考上工程师，很厉害了。"
    },
    {
        "TextId": 12,
        "ActorName": "泰勒维尔",
        "ActorTalk": "辛苦都是值得的。"
    }
]