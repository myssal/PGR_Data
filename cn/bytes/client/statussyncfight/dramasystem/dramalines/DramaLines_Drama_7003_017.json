    {
        "TextId": 17,
        "ActorName": "法奥斯军官",
        "ActorTalk": "但我相信已没有任何事物能阻拦我们前进的步伐"
    },
    {
        "TextId": 18,
        "ActorName": "法奥斯军官",
        "ActorTalk": "我相信人类终将战胜帕弥什"
    },
    {
        "TextId": 19,
        "ActorName": "法奥斯军官",
        "ActorTalk": "夺回我们的故土！"
    },
    {
        "TextId": 20,
        "ActorName": "法奥斯军官",
        "ActorTalk": "夺回我们的地球！"
    },
    {
