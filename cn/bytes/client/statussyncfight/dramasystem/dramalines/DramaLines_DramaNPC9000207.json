[
    {
        "TextId": 1,
        "ActorName": "维鲁斯",
        "ActorTalk": "不然……我还是去自首吧。"
    },
    {
        "TextId": 2,
        "ActorName": "[PlayerName]",
        "ActorTalk": "自首？"
    },
    {
        "TextId": 3,
        "ActorName": "维鲁斯",
        "ActorTalk": "啊，您是灰鸦指挥官！"
    },
    {
        "TextId": 4,
        "ActorName": "维鲁斯",
        "ActorTalk": "前辈，请帮帮我！我好像……不，我应该是闯祸了。"
    },
    {
        "TextId": 5,
        "ActorName": "[PlayerName]",
        "ActorTalk": "你做了什么？"
    },
    {
        "TextId": 6,
        "ActorName": "维鲁斯",
        "ActorTalk": "我……擅自对园区的库洛洛做了一点“小小的”改造……"
    },
    {
        "TextId": 7,
        "ActorName": "维鲁斯",
        "ActorTalk": "因为私自改造库洛洛这件事，我已经被翠丝怀疑了，还连累她被惩罚。"
    },
    {
        "TextId": 8,
        "ActorName": "维鲁斯",
        "ActorTalk": "如果继续隐瞒下去，不知道还会发生什么糟糕的事情。"
    },
    {
        "TextId": 9,
        "ActorName": "[PlayerName]",
        "ActorTalk": "如果是我的话，一定会选择勇敢面对。"
    },
    {
        "TextId": 10,
        "ActorName": "维鲁斯",
        "ActorTalk": "这样吗？"
    },
    {
        "TextId": 11,
        "ActorName": "[PlayerName]",
        "ActorTalk": "我不会回避属于我的责任。"
    },
    {
        "TextId": 12,
        "ActorName": "维鲁斯",
        "ActorTalk": "好吧，我明白应该怎么做了，谢谢您。"
    },
    {
        "TextId": 13,
        "ActorName": "维鲁斯",
        "ActorTalk": "啊，我确实参加了科学理事会试推行的现役人员提升课程。"
    },
    {
        "TextId": 14,
        "ActorName": "维鲁斯",
        "ActorTalk": "那门《智械理论与战时多维度实操练习（初级）》，我是唯一通过的学员！"
    },
    {
        "TextId": 15,
        "ActorName": "维鲁斯",
        "ActorTalk": "我没有说谎。"
    },
    {
        "TextId": 16,
        "ActorName": "维鲁斯",
        "ActorTalk": "我的水平也只能做一些无伤大雅的小修改而已。"
    },
    {
        "TextId": 17,
        "ActorTalk": "你小子，应该去科学理事会吧。"
    },
    {
        "TextId": 18,
        "ActorTalk": "你心虚的声音显得很可疑。"
    }
]