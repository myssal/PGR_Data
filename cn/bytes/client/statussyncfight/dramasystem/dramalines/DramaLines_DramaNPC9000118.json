[
    {
        "TextId": 1,
        "ActorName": "库助助",
        "ActorTalk": "您好，请问有什么需要帮助吗？"
    },
    {
        "TextId": 2,
        "ActorName": "库助助",
        "ActorTalk": "环星长廊，是商业区的核心主干道。"
    },
    {
        "TextId": 3,
        "ActorName": "库助助",
        "ActorTalk": "从前沿的时尚服饰到风味各异的美食佳肴，琳琅满目的商品在这里汇聚。"
    },
    {
        "TextId": 4,
        "ActorName": "库助助",
        "ActorTalk": "一站式的便捷体验，使其成为了附近居民日常采购的首要选择。"
    },
    {
        "TextId": 5,
        "ActorName": "库助助",
        "ActorTalk": "而购物之外，开放舒适的环境与氛围也吸引着人们在此漫步、相聚。"
    },
    {
        "TextId": 6,
        "ActorName": "库助助",
        "ActorTalk": "环星长廊不仅是商业繁荣的直观体现，也是一扇展现商业区居民生活风情的窗口。"
    },
    {
        "TextId": 7,
        "ActorName": "库助助",
        "ActorTalk": "漫步其间，相信您能切身感受到这份融合了商业活力与生活气息的独特魅力。"
    },
    {
        "TextId": 8,
        "ActorTalk": "请给我介绍下“环星长廊”。"
    },
    {
        "TextId": 9,
        "ActorTalk": "没什么事。"
    }
]