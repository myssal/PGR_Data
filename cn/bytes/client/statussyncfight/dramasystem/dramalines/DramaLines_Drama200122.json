[
    {
        "TextId": 1,
        "ActorName": "[PlayerName]",
        "ActorTalk": "约斯小姐，我需要你的帮助。"
    },
    {
        "TextId": 2,
        "ActorName": "约斯",
        "ActorTalk": "……啧，我什么都不会告诉你的。",
        "Cv": 510002193
    },
    {
        "TextId": 3,
        "ActorName": "[PlayerName]",
        "ActorTalk": "我会向有关部门如实反应你的配合情况，你说得越多，对你当下的情况越有利。"
    },
    {
        "TextId": 4,
        "ActorName": "约斯",
        "ActorTalk": "……不知道。",
        "Cv": 510002194
    },
    {
        "TextId": 5,
        "ActorName": "薇拉",
        "ActorTalk": "呵，要我说，你这就是在浪费时间。把她交给我，我会让她开口的。",
        "Cv": 510002195
    },
    {
        "TextId": 6,
        "ActorName": "[PlayerName]",
        "ActorTalk": "……约斯，你应该认识，我身旁这位是谁吧？"
    },
    {
        "TextId": 7,
        "ActorName": "约斯",
        "ActorTalk": "……",
        "Cv": 510002196
    },
    {
        "TextId": 8,
        "ActorName": "约斯",
        "ActorTalk": "我、我不知道。",
        "Cv": 510002197
    },
    {
        "TextId": 9,
        "ActorName": "薇拉",
        "ActorTalk": "……[PlayerName]，我有点渴了，帮我去买罐电解液。",
        "Cv": 510002198
    },
    {
        "TextId": 10,
        "ActorName": "薇拉",
        "ActorTalk": "就近找个地方买就行，等你回来，我也差不多问完了。",
        "Cv": 510002199
    },
    {
        "TextId": 11,
        "ActorName": "薇拉",
        "ActorTalk": "好了，这里就剩下我们两个人了。让我想想，该怎么陪你玩呢？",
        "Cv": 510002200
    },
    {
        "TextId": 12,
        "ActorName": "约斯",
        "ActorTalk": "你……你要做什么？",
        "Cv": 510002201
    },
    {
        "TextId": 13,
        "ActorName": "薇拉",
        "ActorTalk": "你知道吗？再怎么习惯沉默的人，当尖枪划破喉咙时，都会无可抗拒地发出濒死的呜咽。",
        "Cv": 510002202
    },
    {
        "TextId": 14,
        "ActorName": "薇拉",
        "ActorTalk": "像你们这样的人，总容易把自己想得太过重要，好像守住那点秘密，全世界都会把你敬奉成殉道者似的。",
        "Cv": 510002203
    },
    {
        "TextId": 15,
        "ActorName": "薇拉",
        "ActorTalk": "但实际情况是，牢里还有七八个杂碎在排队等着我，前面的人不说，我就撕开他们的喉咙给后面的人听……",
        "Cv": 510002204
    },
    {
        "TextId": 16,
        "ActorName": "约斯",
        "ActorTalk": "别过来，别伤害我！",
        "Cv": 510002205
    },
    {
        "TextId": 17,
        "ActorName": "薇拉",
        "ActorTalk": "总会有废物吐出我想要的答案……到那个时候，前面的人，就全都白死了。",
        "Cv": 510002206
    },
    {
        "TextId": 18,
        "ActorName": "约斯",
        "ActorTalk": "我、我什么都说，求你了！",
        "Cv": 510002207
    },
    {
        "TextId": 19,
        "ActorName": "约斯",
        "ActorTalk": "有倒是有，但是……",
        "Cv": 510002210
    },
    {
        "TextId": 20,
        "ActorName": "薇拉",
        "ActorTalk": "——嗯？",
        "Cv": 510002211
    },
    {
        "TextId": 21,
        "ActorName": "约斯",
        "ActorTalk": "但、但是我们每次都是在时序广场附近集合，然后被蒙住眼睛，穿过一条地下密道，来到一个黑色的房间……",
        "Cv": 510002212
    },
    {
        "TextId": 22,
        "ActorName": "薇拉",
        "ActorTalk": "从时序广场出发，要花多长时间才能到那里？",
        "Cv": 510002213
    },
    {
        "TextId": 23,
        "ActorName": "约斯",
        "ActorTalk": "大概要……十分钟左右。",
        "Cv": 510002214
    },
    {
        "TextId": 24,
        "ActorName": "薇拉",
        "ActorTalk": "那处黑房间附近有没有什么特别的地方？比如装潢风格、环境之类的？",
        "Cv": 510002215
    },
    {
        "TextId": 25,
        "ActorName": "约斯",
        "ActorTalk": "我也只去过两次，只记得那里的空间很大，很黑，有点像是库房……",
        "Cv": 510002216
    },
    {
        "TextId": 26,
        "ActorName": "约斯",
        "ActorTalk": "环境……记得上一次，我依稀听到了楼上传来爵士乐的声音。",
        "Cv": 510002217
    },
    {
        "TextId": 27,
        "ActorName": "薇拉",
        "ActorTalk": "……爵士乐？还有别的吗？",
        "Cv": 510002218
    },
    {
        "TextId": 28,
        "ActorName": "约斯",
        "ActorTalk": "我……我已经把知道的全跟你说了，求你放了我吧……",
        "Cv": 510002219
    },
    {
        "TextId": 29,
        "ActorName": "薇拉",
        "ActorTalk": "啧，你再嚎两声，我就真要把你脖子抹了。",
        "Cv": 510002220
    },
    {
        "TextId": 30,
        "ActorName": "薇拉",
        "ActorTalk": "给我老实呆着，等[PlayerName]回来。",
        "Cv": 510002221
    },
    {
        "TextId": 31,
        "ActorName": "[PlayerName]",
        "ActorTalk": "辛苦你了，薇拉。"
    },
    {
        "TextId": 32,
        "ActorName": "薇拉",
        "ActorTalk": "对付这种软蛋算不上什么辛苦，比那种不得不溅你一身血的傻子强多了。",
        "Cv": 510002222
    },
    {
        "TextId": 33,
        "ActorName": "薇拉",
        "ActorTalk": "接着说正事，根据刚才套到的情报，整个商业区应该只有一个地方符合这些特点……",
        "Cv": 510002223
    },
    {
        "TextId": 34,
        "ActorName": "薇拉",
        "ActorTalk": "我们直接去问问星尘酿泡的负责人，看看他有什么解释。",
        "Cv": 510002227
    },
    {
        "TextId": 35,
        "ActorName": "约斯",
        "ActorTalk": "我也是拿钱办事，别的什么都不知道……真的！没骗你！",
        "Cv": 510002209
    },
    {
        "TextId": 36,
        "ActorName": "约斯",
        "ActorTalk": "芙洛世商会的赫西亚。我也是刚入伙不久，只送了几份威胁信，别的什么也没做！",
        "Cv": 510002208
    },
    {
        "TextId": 37,
        "ActorName": "薇拉",
        "ActorTalk": "没错，而且按照约斯的说法，那个秘密据点应该就在星尘酿泡的下面。",
        "Cv": 510002226
    },
    {
        "TextId": 38,
        "ActorName": "薇拉",
        "ActorTalk": "你不是和那家店的老板很熟吗，他有没有跟你说过，店里有什么隐藏的秘密通道？",
        "Cv": 510002225
    },
    {
        "TextId": 39,
        "ActorName": "薇拉",
        "ActorTalk": "你回来的路上是不是被车给撞了？你的意思是，这帮人从时序广场出发，兜了一大圈，最后又跑了回来？",
        "Cv": 510002224
    },
    {
        "TextId": 40,
        "ActorTalk": "你们在为谁工作？"
    },
    {
        "TextId": 41,
        "ActorTalk": "你们为什么要阻挠开发计划？"
    },
    {
        "TextId": 42,
        "ActorTalk": "你们有固定的据点吗？"
    },
    {
        "TextId": 43,
        "ActorTalk": "我正在帮你。"
    },
    {
        "TextId": 44,
        "ActorTalk": "你再不说，大的就要来了。"
    },
    {
        "TextId": 45,
        "ActorTalk": "星尘酿泡。"
    },
    {
        "TextId": 46,
        "ActorTalk": "库洛洛咖啡。"
    },
    {
        "TextId": 47,
        "ActorTalk": "时序广场。"
    },
    {
        "TextId": 48,
        "ActorTalk": "好，现在就出发吧。"
    },
    {
        "TextId": 49,
        "ActorTalk": "之前从没听说过星尘酿泡有地下设施。"
    },
    {
        "TextId": 50,
        "ActorTalk": "我对店里的环境还挺熟的，应该没有。"
    }
]