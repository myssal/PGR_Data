[
    {
        "TextId": 1,
        "ActorName": "【kuroname】",
        "ActorTalk": "嘘——"
    },
    {
        "TextId": 2,
        "ActorName": "投影讲师",
        "ActorTalk": "为了检验听课效率，我将抽取一位学生进行提问。",
        "Cv": 510031041
    },
    {
        "TextId": 3,
        "ActorName": "投影讲师",
        "ActorTalk": "座位号z136的同学，你的名字没有出现在Gestalt课堂抽选系统中，你是开放日来的旁听生？",
        "Cv": 510031042
    },
    {
        "TextId": 4,
        "ActorName": "投影讲师",
        "ActorTalk": "请你回答我的问题：法奥斯学院在第几次转移时完成了空中花园的转型后建立？",
        "Cv": 510031043
    },
    {
        "TextId": 5,
        "ActorName": "神威",
        "ActorTalk": "啊？是让我回答吗？",
        "Cv": 510031044
    },
    {
        "TextId": 6,
        "ActorName": "神威",
        "ActorTalk": "嗯……欸……这个的答案是……",
        "Cv": 510031045
    },
    {
        "TextId": 7,
        "ActorName": "【kuroname】",
        "ActorTalk": "第三次。"
    },
    {
        "TextId": 8,
        "ActorName": "【kuroname】",
        "ActorTalk": "五次。"
    },
    {
        "TextId": 9,
        "ActorName": "【kuroname】",
        "ActorTalk": "（让神威自己思考）"
    },
    {
        "TextId": 10,
        "ActorName": "神威",
        "ActorTalk": "我知道了！答案是第三次！",
        "Cv": 510031046
    },
    {
        "TextId": 11,
        "ActorName": "投影讲师",
        "ActorTalk": "嗯，虽然上课态度不够端正，但你还是有在用心学习的。",
        "Cv": 510031047
    },
    {
        "TextId": 12,
        "ActorName": "投影讲师",
        "ActorTalk": "请就坐。",
        "Cv": 510031048
    },
    {
        "TextId": 13,
        "ActorName": "神威",
        "ActorTalk": "谢谢指挥官，下次我一定会靠自己的力量答出来的。",
        "Cv": 510031049
    },
    {
        "TextId": 14,
        "ActorName": "神威",
        "ActorTalk": "我知道了！答案是五次！",
        "Cv": 510031050
    },
    {
        "TextId": 15,
        "ActorName": "投影讲师",
        "ActorTalk": "充满自信是好事，前提是你的水平足以让你自信。",
        "Cv": 510031051
    },
    {
        "TextId": 16,
        "ActorName": "神威",
        "ActorTalk": "欸？",
        "Cv": 510031052
    },
    {
        "TextId": 17,
        "ActorName": "投影讲师",
        "ActorTalk": "回答错误，坐下吧。",
        "Cv": 510031053
    },
    {
        "TextId": 18,
        "ActorName": "神威",
        "ActorTalk": "怎么会错……难道……我听错了指挥官的提醒？我要申报听觉模块的检查。",
        "Cv": 510031054
    },
    {
        "TextId": 19,
        "ActorName": "【kuroname】",
        "ActorTalk": "……是我看错题目了，抱歉。"
    },
    {
        "TextId": 20,
        "ActorName": "神威",
        "ActorTalk": "抱歉，我不知道答案……",
        "Cv": 510031055
    },
    {
        "TextId": 21,
        "ActorName": "投影讲师",
        "ActorTalk": "我非常失望，在如此神圣的课堂，竟会发生不认真听讲的行为。",
        "Cv": 510031056
    },
    {
        "TextId": 22,
        "ActorName": "投影讲师",
        "ActorTalk": "坐下吧。",
        "Cv": 510031057
    },
    {
        "TextId": 23,
        "ActorName": "神威",
        "ActorTalk": "好的……",
        "Cv": 510031058
    },
    {
        "TextId": 24,
        "ActorName": "神威",
        "ActorTalk": "总觉得有些不好意思，是不是影响到老师上课了？",
        "Cv": 510031059
    },
    {
        "TextId": 25,
        "ActorName": "神威",
        "ActorTalk": "嗯——我尽量忍住。",
        "Cv": 510031060
    },
    {
        "TextId": 26,
        "ActorName": "神威",
        "ActorTalk": "但……好不容易才能和指挥官成为同学……不想浪费这段时光……",
        "Cv": 510031061
    }
]