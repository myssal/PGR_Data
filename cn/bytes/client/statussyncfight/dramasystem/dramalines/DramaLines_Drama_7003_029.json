[
    {
        "TextId": 1,
        "ActorName": "构造体",
        "ActorTalk": "我刚刚才和我的指挥官聊起你然后你就出现了，好巧哦！"
    },
    {
        "TextId": 2,
        "ActorName": "穿着得体的男性",
        "ActorTalk": "只是说之前的几个大战役中你都有些什么表现而已，还有，我是你的前指挥官才对。"
    },
    {
        "TextId": 3,
        "ActorName": "构造体",
        "ActorTalk": "指挥官一辈子都是我的指挥官，就算是退役也是一样！"
    },
    {
        "TextId": 4,
        "ActorName": "穿着得体的男性",
        "ActorTalk": "是的，虽然我们没见过，但我和你一样参与过普利亚森林公园战役。"
    },
    {
        "TextId": 5,
        "ActorName": "穿着得体的男性",
        "ActorTalk": "在当时我负责的是游击和输送的职责，虽然最后因为战友保佑活了下来，但我却患上了很严重的呼吸道疾病。"
    },
    {
        "TextId": 6,
        "ActorName": "穿着得体的男性",
        "ActorTalk": "在经过一系列检查以后，我就收到了不能再前往前线的通知书，于是就只能退役成为前指挥官了。"
    },
    {
        "TextId": 7,
        "ActorName": "穿着得体的男性",
        "ActorTalk": "能听到你这么说我真的很开心，但是可不能让你一个人承担那么多，后勤也有后勤发光发热的地方。"
    },
    {
        "TextId": 8,
        "ActorName": "穿着得体的男性",
        "ActorTalk": "一起加油吧，【kuroname】。"
    },
    {
        "TextId": 9,
        "ActorTalk": "聊我什么？"
    },
    {
        "TextId": 10,
        "ActorTalk": "你退役了吗？"
    },
    {
        "TextId": 11,
        "ActorTalk": "我会连你的份一起加油的。"
    }
]