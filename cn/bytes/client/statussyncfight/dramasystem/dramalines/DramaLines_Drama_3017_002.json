[
    {
        "TextId": 1,
        "ActorName": "凡妮莎",
        "ActorTalk": "令人失望。几年过去了，排行榜前面的还是这几个名字。"
    },
    {
        "TextId": 2,
        "ActorName": "凡妮莎",
        "ActorTalk": "后来的家伙里就没有像样点的吗？不够格的下到地表也是徒增累赘。"
    },
    {
        "TextId": 3,
        "ActorName": "凡妮莎",
        "ActorTalk": "之前那种激烈的实战演练应该保留才是，免得一些废物能顺利毕业混入军队。"
    },
    {
        "TextId": 4,
        "ActorName": "[PlayerName]",
        "ActorTalk": "数字不能成为判断价值的唯一标准。"
    },
    {
        "TextId": 5,
        "ActorName": "[PlayerName]",
        "ActorTalk": "踏上战场时，现在的高要求确实能帮他们的安全上一份保险。"
    },
    {
        "TextId": 6,
        "ActorName": "凡妮莎",
        "ActorTalk": "虽然料到你会说这种义正词严的话，但亲耳听见还是觉得可笑。"
    },
    {
        "TextId": 7,
        "ActorName": "凡妮莎",
        "ActorTalk": "还以为同情心泛滥的灰鸦指挥官会反驳我呢。"
    },
    {
        "TextId": 8,
        "ActorName": "凡妮莎",
        "ActorTalk": "算了，多一些这样的货色也无所谓。"
    },
    {
        "TextId": 9,
        "ActorName": "凡妮莎",
        "ActorTalk": "朽木处理一下至少可以做薪柴。"
    }
]