[
    {
        "TextId": 1,
        "ActorName": "狄狄",
        "ActorTalk": "怎么还没有来呢？"
    },
    {
        "TextId": 2,
        "ActorTalk": "你在等谁？"
    },
    {
        "TextId": 3,
        "ActorName": "狄狄",
        "ActorTalk": "我在等我的伙伴，他一直都没来。我猜他可能是被那个著名社团绊住了。"
    },
    {
        "TextId": 4,
        "ActorTalk": "需要我帮忙吗"
    },
    {
        "TextId": 5,
        "ActorName": "狄狄",
        "ActorTalk": "没关系……我很擅长等待。"
    },
    {
        "TextId": 6,
        "ActorName": "狄狄",
        "ActorTalk": "我之前和我的伙伴在等待一个家伙，虽然他永远不会到来。但不管出于什么原因，每一次的挫败都会再次燃起我们对他更高的期望。"
    },
    {
        "TextId": 7,
        "ActorName": "狄狄",
        "ActorTalk": "我已经习惯了这种感受，我也享受这份期待。"
    }
]