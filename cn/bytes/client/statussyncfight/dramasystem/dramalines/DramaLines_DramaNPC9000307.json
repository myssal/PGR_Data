[
    {
        "TextId": 1,
        "ActorName": "维克特",
        "ActorTalk": "我一直认为中央电梯是人类最伟大的发明之一。"
    },
    {
        "TextId": 2,
        "ActorName": "维克特",
        "ActorTalk": "一台有着巨兽般运力的电梯怪物，配合周围的多台小型电梯，将等待时间缩短了一半以上。"
    },
    {
        "TextId": 3,
        "ActorName": "维克特",
        "ActorTalk": "作战结束后可以早早回到休息室休息，不用以疲惫的身躯等电梯，这种感觉可太好了。"
    },
    {
        "TextId": 4,
        "ActorTalk": "何出此言。"
    },
    {
        "TextId": 5,
        "ActorTalk": "不能再感同身受。"
    }
]