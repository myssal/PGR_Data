[
    {
        "TextId": 1,
        "ActorName": "万事",
        "ActorTalk": "你来了，[PlayerName]。",
        "Cv": 0
    },
    {
        "TextId": 2,
        "ActorName": "[PlayerName]",
        "ActorTalk": "抱歉，等很久了吗？",
        "Cv": 0
    },
    {
        "TextId": 3,
        "ActorName": "[PlayerName]",
        "ActorTalk": "没想到你来得这么早。",
        "Cv": 0
    },
    {
        "TextId": 4,
        "ActorName": "[PlayerName]",
        "ActorTalk": "嗨！",
        "Cv": 0
    },
    {
        "TextId": 5,
        "ActorName": "万事",
        "ActorTalk": "因为不想让你等我，所以稍微来早了一些。",
        "Cv": 0
    },
    {
        "TextId": 6,
        "ActorName": "万事",
        "ActorTalk": "昨天一直在忙任务……直到很晚才空闲下来。",
        "Cv": 0
    },
    {
        "TextId": 7,
        "ActorName": "[PlayerName]",
        "ActorTalk": "黑眼圈好重，你真的休息好了吗？",
        "Cv": 0
    },
    {
        "TextId": 8,
        "ActorName": "万事",
        "ActorTalk": "没关系，任务间隙里也一直在休息。休息方式是闭上眼睛思考“和你看一整天电影”的事。",
        "Cv": 0
    },
    {
        "TextId": 9,
        "ActorName": "万事",
        "ActorTalk": "要选什么影厅，选什么类型的电影，看完电影之后要怎么安排……怎么才能够让今天更有意义一点。",
        "Cv": 0
    },
    {
        "TextId": 10,
        "ActorName": "[PlayerName]",
        "ActorTalk": "除了看电影，还有别的项目？",
        "Cv": 0
    },
    {
        "TextId": 11,
        "ActorName": "[PlayerName]",
        "ActorTalk": "我要检查你昨晚的休眠数据。",
        "Cv": 0
    },
    {
        "TextId": 12,
        "ActorName": "万事",
        "ActorTalk": "有的，我在休息室搭好了柔软的卧榻，方便我们看完电影就冲回去躺下，极速开始窝在一起睡大觉。",
        "Cv": 0
    },
    {
        "TextId": 13,
        "ActorName": "万事",
        "ActorTalk": "不过，至少现在，就先一起好好享受电影吧。",
        "Cv": 0
    },
    {
        "TextId": 14,
        "ActorName": "万事",
        "ActorTalk": "之后的事情，就在梦里安排吧。现在不如先挑挑影厅模式？",
        "Cv": 0
    },
    {
        "TextId": 15,
        "ActorName": "万事",
        "ActorTalk": "那你只能查到我一整晚在各大信息平台的浏览记录，你会无聊地发现我只是在反复阅读最近上映的每一部影片的梗概，和附近每一家餐厅的评论区。",
        "Cv": 0
    },
    {
        "TextId": 16,
        "ActorName": "万事",
        "ActorTalk": "或是从我的视觉数据记录中，发现我昨晚回突击鹰小队的休息室之后，就对着镜子检查了21遍头顶那撮怎么也按不下来的头发，直到被库洛姆看到和被神威嘲笑。",
        "Cv": 0
    },
    {
        "TextId": 17,
        "ActorName": "万事",
        "ActorTalk": "……算了，总之我还是被强制休息了一会的，别担心，先挑挑影厅模式吧。",
        "Cv": 0
    },
    {
        "TextId": 18,
        "ActorName": "万事",
        "ActorTalk": "按照影院的说明，我们可以选传统的私人影厅，或者VR设备的实时演绎。",
        "Cv": 0
    },
    {
        "TextId": 19,
        "ActorName": "万事",
        "ActorTalk": "[PlayerName]，主动权就交给你了。",
        "Cv": 0
    },
    {
        "TextId": 20,
        "ActorName": "[PlayerName]",
        "ActorTalk": "私人影厅",
        "Cv": 0
    },
    {
        "TextId": 21,
        "ActorName": "[PlayerName]",
        "ActorTalk": "虚拟演绎",
        "Cv": 0
    }
]